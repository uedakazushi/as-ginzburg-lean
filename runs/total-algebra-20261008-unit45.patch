index 0000000..ed8241b
--- /dev/null
+++ b/ASGinzburg/GinzburgCutRetracts.lean
@@ -0,0 +1,81 @@
+import ASGinzburg.GinzburgCutCochainComplex
+import ASGinzburg.GinzburgCutProjections
+import ASGinzburg.GinzburgRegularity
+
+/-! Fixed cut complexes are genuine retracts of the original path complexes,
+so actual regularity implies their negative homology vanishes. -/
+namespace ASGinzburg.CutQuiver
+open CategoryTheory CategoryTheory.Limits
+universe u
+variable (Q : CutQuiver) (k : Type u) [Field k]
+
+noncomputable def ginzburgCutCochainProjectionTerm (u v : Q.Vertex) (q c : ℤ) :
+    Q.ginzburgCohomologicalComponent k u v q →ₗ[k]
+      Q.ginzburgCutCohomologicalComponent k u v q c :=
+  ((Q.ginzburgCutProjection k u v c).comp
+    (Q.ginzburgCohomologicalComponent k u v q).subtype).codRestrict _
+      (fun f => ⟨Q.ginzburgCutProjection_cohomological k c q f.property,
+        Q.ginzburgCutProjection_mem k c f.val⟩)
+
+noncomputable def ginzburgCutCochainInclusion (φ : Q.Potential k) (u v : Q.Vertex) (c : ℤ) :
+    Q.ginzburgCutCochainComplex k φ u v c ⟶ Q.ginzburgCochainComplex k φ u v :=
+  CochainComplex.ofHom _ _ _ _ _ _
+    (fun q => ModuleCat.ofHom (Submodule.inclusion
+      (show Q.ginzburgCutCohomologicalComponent k u v q c ≤
+        Q.ginzburgCohomologicalComponent k u v q from inf_le_left)))
+    (fun q => by
+      apply ModuleCat.hom_ext
+      apply LinearMap.ext
+      intro f
+      apply Subtype.ext
+      rfl)
+
+noncomputable def ginzburgCutCochainProjection (φ : Q.Potential k) (u v : Q.Vertex) (c : ℤ) :
+    Q.ginzburgCochainComplex k φ u v ⟶ Q.ginzburgCutCochainComplex k φ u v c :=
+  CochainComplex.ofHom _ _ _ _ _ _
+    (fun q => ModuleCat.ofHom (Q.ginzburgCutCochainProjectionTerm k u v q c))
+    (fun q => by
+      apply ModuleCat.hom_ext
+      apply LinearMap.ext
+      intro f
+      apply Subtype.ext
+      exact Q.ginzburgDifferential_cutProjection k φ c f.val)
+
+theorem ginzburgCutCochainInclusion_projection (φ : Q.Potential k) (u v : Q.Vertex) (c : ℤ) :
+    Q.ginzburgCutCochainInclusion k φ u v c ≫ Q.ginzburgCutCochainProjection k φ u v c=𝟙 _ := by
+  apply HomologicalComplex.hom_ext
+  intro q
+  apply ModuleCat.hom_ext
+  apply LinearMap.ext
+  intro f
+  apply Subtype.ext
+  change Q.ginzburgCutProjection k u v c f.val=f.val
+  rw [Q.ginzburgCutProjection_on_cut k c c f.property.2,if_pos rfl]
+
+noncomputable def ginzburgCutHomologyInclusion (φ : Q.Potential k) (u v : Q.Vertex) (c q : ℤ) :
+    Q.ginzburgCutHomology k φ u v c q ⟶ Q.ginzburgHomology k φ u v q :=
+  (HomologicalComplex.homologyFunctor (ModuleCat k) (ComplexShape.up ℤ) q).map
+    (Q.ginzburgCutCochainInclusion k φ u v c)
+
+noncomputable def ginzburgCutHomologyProjection (φ : Q.Potential k) (u v : Q.Vertex) (c q : ℤ) :
+    Q.ginzburgHomology k φ u v q ⟶ Q.ginzburgCutHomology k φ u v c q :=
+  (HomologicalComplex.homologyFunctor (ModuleCat k) (ComplexShape.up ℤ) q).map
+    (Q.ginzburgCutCochainProjection k φ u v c)
+
+theorem ginzburgCutHomologyInclusion_projection (φ : Q.Potential k) (u v : Q.Vertex) (c q : ℤ) :
+    Q.ginzburgCutHomologyInclusion k φ u v c q ≫ Q.ginzburgCutHomologyProjection k φ u v c q=𝟙 _ := by
+  change (HomologicalComplex.homologyFunctor (ModuleCat k) (ComplexShape.up ℤ) q).map _ ≫
+    (HomologicalComplex.homologyFunctor (ModuleCat k) (ComplexShape.up ℤ) q).map _=_
+  rw [←CategoryTheory.Functor.map_comp,Q.ginzburgCutCochainInclusion_projection,
+    CategoryTheory.Functor.map_id]
+  rfl
+
+theorem GinzburgRegular.cutHomology_isZero {φ : Q.Potential k} (h : Q.GinzburgRegular k φ)
+    (u v : Q.Vertex) (c q : ℤ) (hq : q<0) : IsZero (Q.ginzburgCutHomology k φ u v c q) := by
+  letI : IsSplitMono (Q.ginzburgCutHomologyInclusion k φ u v c q) :=
+    IsSplitMono.mk' ⟨Q.ginzburgCutHomologyProjection k φ u v c q,
+      Q.ginzburgCutHomologyInclusion_projection k φ u v c q⟩
+  exact IsZero.of_mono (Q.ginzburgCutHomologyInclusion k φ u v c q)
+    ((Q.ginzburgRegular_iff_components k φ).mp h u v q hq)
+
+end ASGinzburg.CutQuiver
diff --git a/ASGinzburg/GinzburgCutBounds.lean b/ASGinzburg/GinzburgCutBounds.lean
new file mode 100644
index 0000000..34c548d
--- /dev/null
+++ b/ASGinzburg/GinzburgCutBounds.lean
@@ -0,0 +1,68 @@
+import ASGinzburg.GinzburgCutCochainComplex
+
+/-! Fixed cut components have a concrete finite cohomological range,
+deduced from positive winding and the genuine generator degrees. -/
+namespace ASGinzburg.CutQuiver
+open CategoryTheory CategoryTheory.Limits
+variable (Q : CutQuiver)
+
+theorem GinzburgPath.cohomologicalDegree_lower_length {u v : Q.Vertex}
+    (p : Q.GinzburgPath u v) : -2*(p.length:ℤ) ≤ p.cohomologicalDegree := by
+  induction p with
+  | nil => simp [length,cohomologicalDegree]
+  | snoc p a h ih =>
+    cases a <;>
+      simp only [length,cohomologicalDegree,GinzburgArrow.cohomologicalDegree,
+        Nat.cast_add,Nat.cast_one] <;> omega
+
+theorem GinzburgPath.cohomologicalDegree_lower_winding {u v : Q.Vertex}
+    (p : Q.GinzburgPath u v) : -2*p.winding ≤ p.cohomologicalDegree := by
+  have := p.cohomologicalDegree_lower_length Q
+  have := p.length_le_winding Q
+  omega
+
+theorem GinzburgPath.cohomologicalDegree_lower_cut {u v : Q.Vertex}
+    (p : Q.GinzburgPath u v) :
+    -2*((v.val:ℤ)-u.val+Q.vertices*p.cutDegree) ≤ p.cohomologicalDegree := by
+  simpa only [p.winding_formula] using p.cohomologicalDegree_lower_winding Q
+
+universe u
+variable (k : Type u) [Field k]
+
+theorem ginzburgCutCohomologicalComponent_eq_bot_of_lt (u v : Q.Vertex) (c q : ℤ)
+    (hq : q < -2*((v.val:ℤ)-u.val+Q.vertices*c)) :
+    Q.ginzburgCutCohomologicalComponent k u v q c=⊥ := by
+  change Finsupp.supported k k _ ⊓ Finsupp.supported k k _=⊥
+  rw [←Finsupp.supported_inter]
+  have hs : {p : Q.GinzburgPath u v | p.cohomologicalDegree=q} ∩
+      {p : Q.GinzburgPath u v | p.cutDegree=c}=∅ := by
+    ext p
+    simp only [Set.mem_inter_iff,Set.mem_setOf_eq,Set.mem_empty_iff_false,iff_false]
+    rintro ⟨hp,hc⟩
+    have h := p.cohomologicalDegree_lower_cut Q
+    rw [hp,hc] at h
+    omega
+  rw [hs,Finsupp.supported_empty]
+
+theorem ginzburgCutCohomologicalComponent_eq_bot_of_pos (u v : Q.Vertex) (c q : ℤ)
+    (hq : 0<q) : Q.ginzburgCutCohomologicalComponent k u v q c=⊥ := by
+  unfold ginzburgCutCohomologicalComponent
+  rw [Q.ginzburgCohomologicalComponent_eq_bot_of_pos k u v hq,bot_inf_eq]
+
+theorem ginzburgCutCochainTerm_isZero_of_outside (u v : Q.Vertex) (c q : ℤ)
+    (hq : q < -2*((v.val:ℤ)-u.val+Q.vertices*c) ∨ 0<q) :
+    IsZero (ModuleCat.of k (Q.ginzburgCutCohomologicalComponent k u v q c)) := by
+  have hb : Q.ginzburgCutCohomologicalComponent k u v q c=⊥ := by
+    rcases hq with hq|hq
+    · exact Q.ginzburgCutCohomologicalComponent_eq_bot_of_lt k u v c q hq
+    · exact Q.ginzburgCutCohomologicalComponent_eq_bot_of_pos k u v c q hq
+  rw [hb]
+  exact ModuleCat.isZero_of_subsingleton _
+
+theorem ginzburgCutHomology_isZero_of_outside (φ : Q.Potential k) (u v : Q.Vertex) (c q : ℤ)
+    (hq : q < -2*((v.val:ℤ)-u.val+Q.vertices*c) ∨ 0<q) :
+    IsZero (Q.ginzburgCutHomology k φ u v c q) :=
+  ((Q.ginzburgCutCochainComplex k φ u v c).sc q).isZero_homology_of_isZero_X₂
+    (Q.ginzburgCutCochainTerm_isZero_of_outside k u v c q hq)
+
+end ASGinzburg.CutQuiver
diff --git a/ASGinzburg/PathCutGrading.lean b/ASGinzburg/PathCutGrading.lean
new file mode 100644
index 0000000..5bc69eb
--- /dev/null
+++ b/ASGinzburg/PathCutGrading.lean
@@ -0,0 +1,75 @@
+import ASGinzburg.GinzburgCutProjections
+import ASGinzburg.GinzburgPathFiniteness
+
+/-! The original path cut grading agrees with the actual degree zero
+Ginzburg grading, including its concrete homogeneous projections. -/
+namespace ASGinzburg.CutQuiver
+variable (Q : CutQuiver)
+
+universe u
+variable (k : Type u) [Field k]
+
+def pathCutComponent (u v : Q.Vertex) (c : ℤ) : Submodule k (Q.PathComponent k u v) :=
+  Finsupp.supported k k {p | (p.cutDegree:ℤ)=c}
+
+noncomputable def pathCutProjection (u v : Q.Vertex) (c : ℤ) :
+    Q.PathComponent k u v →ₗ[k] Q.PathComponent k u v :=
+  Finsupp.linearCombination k (fun p => if (p.cutDegree:ℤ)=c then Finsupp.single p 1 else 0)
+
+@[simp] theorem pathCutProjection_single {u v : Q.Vertex} (c : ℤ) (p : Q.Path u v) (a : k) :
+    Q.pathCutProjection k u v c (Finsupp.single p a)=
+      if (p.cutDegree:ℤ)=c then Finsupp.single p a else 0 := by
+  classical
+  by_cases h : (p.cutDegree:ℤ)=c <;> simp [pathCutProjection,h]
+
+theorem originalGinzburgLinearMap_cutProjection {u v : Q.Vertex} (c : ℤ)
+    (f : Q.PathComponent k u v) :
+    Q.originalGinzburgLinearMap k u v (Q.pathCutProjection k u v c f)=
+      Q.ginzburgCutProjection k u v c (Q.originalGinzburgLinearMap k u v f) := by
+  classical
+  induction f using Finsupp.induction_linear with
+  | zero => simp
+  | add f g hf hg => simp [map_add,hf,hg]
+  | single p a =>
+    rw [pathCutProjection_single,originalGinzburgLinearMap_single,
+      ginzburgCutProjection_single,p.originalGinzburg_cutDegree Q]
+    split_ifs <;> simp
+
+theorem pathCutProjection_mem {u v : Q.Vertex} (c : ℤ) (f : Q.PathComponent k u v) :
+    Q.pathCutProjection k u v c f ∈ Q.pathCutComponent k u v c := by
+  classical
+  induction f using Finsupp.induction_linear with
+  | zero => simp
+  | add f g hf hg => simpa only [map_add] using Submodule.add_mem _ hf hg
+  | single p a =>
+    rw [pathCutProjection_single]
+    split_ifs with hp
+    · exact Finsupp.single_mem_supported _ _ hp
+    · exact Submodule.zero_mem _
+
+theorem originalGinzburgLinearMap_cut_iff {u v : Q.Vertex} (c : ℤ)
+    (f : Q.PathComponent k u v) :
+    Q.originalGinzburgLinearMap k u v f ∈ Q.ginzburgCutComponent k u v c ↔
+      f ∈ Q.pathCutComponent k u v c := by
+  constructor
+  · intro hf
+    have heq : Q.pathCutProjection k u v c f=f := by
+      apply Q.originalGinzburgLinearMap_injective k u v
+      rw [Q.originalGinzburgLinearMap_cutProjection,
+        Q.ginzburgCutProjection_on_cut k c c hf,if_pos rfl]
+    rw [←heq]
+    exact Q.pathCutProjection_mem k c f
+  · exact Q.originalGinzburgLinearMap_cut k
+
+instance pathCutComponent_finite (u v : Q.Vertex) (c : ℤ) :
+    Module.Finite k (Q.pathCutComponent k u v c) := by
+  let f : Q.pathCutComponent k u v c →ₗ[k] Q.ginzburgCutComponent k u v c :=
+    ((Q.originalGinzburgLinearMap k u v).comp (Q.pathCutComponent k u v c).subtype).codRestrict
+      _ (fun x => Q.originalGinzburgLinearMap_cut k x.property)
+  apply Module.Finite.of_injective f
+  intro x y h
+  apply Subtype.ext
+  apply Q.originalGinzburgLinearMap_injective k u v
+  exact congrArg (fun x : Q.ginzburgCutComponent k u v c => x.val) h
+
+end ASGinzburg.CutQuiver
diff --git a/ASGinzburg/PathJacobianGrading.lean b/ASGinzburg/PathJacobianGrading.lean
new file mode 100644
index 0000000..156bbab
--- /dev/null
+++ b/ASGinzburg/PathJacobianGrading.lean
@@ -0,0 +1,62 @@
+import ASGinzburg.PathCutGrading
+import ASGinzburg.GinzburgCutCochainComplex
+import ASGinzburg.GinzburgJacobianBoundaries
+
+/-! The genuine Jacobian ideal is cut homogeneous. Its degree-c part
+is exactly the image of the genuine degree-c negative-one differential. -/
+namespace ASGinzburg.CutQuiver
+universe u
+variable (Q : CutQuiver) (k : Type u) [Field k]
+
+theorem pathCutProjection_mem_pathJacobianIdeal (φ : Q.Potential k) {u v : Q.Vertex}
+    (c : ℤ) {f : Q.PathComponent k u v} (hf : f ∈ (Q.pathJacobianIdeal k φ).hom u v) :
+    Q.pathCutProjection k u v c f ∈ (Q.pathJacobianIdeal k φ).hom u v := by
+  rw [←Q.ginzburgBoundarySpace_eq_pathJacobianIdeal k φ u v] at hf ⊢
+  obtain ⟨x,hx⟩ := (Q.ginzburgBoundarySpace_mem_iff k φ u v f).mp hf
+  apply (Q.ginzburgBoundarySpace_mem_iff k φ u v _).mpr
+  refine ⟨⟨Q.ginzburgCutProjection k u v c x.val,
+    Q.ginzburgCutProjection_cohomological k c (-1) x.property⟩,?_⟩
+  change Q.ginzburgDifferential k φ u v (Q.ginzburgCutProjection k u v c x.val)=_
+  rw [Q.ginzburgDifferential_cutProjection,hx,Q.originalGinzburgLinearMap_cutProjection]
+
+noncomputable def pathJacobianCutIdeal (φ : Q.Potential k) (u v : Q.Vertex) (c : ℤ) :
+    Submodule k (Q.pathCutComponent k u v c) :=
+  ((Q.pathJacobianIdeal k φ).hom u v).comap (Q.pathCutComponent k u v c).subtype
+
+noncomputable def ginzburgCutBoundaryLift (φ : Q.Potential k) (u v : Q.Vertex) (c : ℤ) :
+    Q.ginzburgCutCohomologicalComponent k u v (-1) c →ₗ[k] Q.pathCutComponent k u v c :=
+  ((Q.ginzburgBoundaryLift k φ u v).comp (Submodule.inclusion
+    (show Q.ginzburgCutCohomologicalComponent k u v (-1) c ≤
+      Q.ginzburgCohomologicalComponent k u v (-1) from inf_le_left))).codRestrict _ (by
+        intro x
+        apply (Q.originalGinzburgLinearMap_cut_iff k c _).mp
+        change Q.originalGinzburgLinearMap k u v
+          (Q.ginzburgBoundaryLift k φ u v ⟨x.val,x.property.1⟩) ∈ _
+        rw [Q.originalGinzburgLinearMap_boundaryLift]
+        exact Q.ginzburgDifferential_cut k φ c x.property.2)
+
+theorem ginzburgCutBoundaryLift_range (φ : Q.Potential k) (u v : Q.Vertex) (c : ℤ) :
+    LinearMap.range (Q.ginzburgCutBoundaryLift k φ u v c)=Q.pathJacobianCutIdeal k φ u v c := by
+  apply Submodule.ext
+  intro f
+  constructor
+  · rintro ⟨x,rfl⟩
+    change Q.ginzburgBoundaryLift k φ u v ⟨x.val,x.property.1⟩ ∈
+      (Q.pathJacobianIdeal k φ).hom u v
+    exact Q.ginzburgBoundaryLift_mem_pathJacobianIdeal k φ u v _
+  · intro hf
+    change f.val ∈ (Q.pathJacobianIdeal k φ).hom u v at hf
+    rw [←Q.ginzburgBoundarySpace_eq_pathJacobianIdeal k φ u v] at hf
+    obtain ⟨x,hx⟩ := (Q.ginzburgBoundarySpace_mem_iff k φ u v f.val).mp hf
+    refine ⟨⟨Q.ginzburgCutProjection k u v c x.val,
+      Q.ginzburgCutProjection_cohomological k c (-1) x.property,
+      Q.ginzburgCutProjection_mem k c x.val⟩,?_⟩
+    apply Subtype.ext
+    apply Q.originalGinzburgLinearMap_injective k u v
+    change Q.originalGinzburgLinearMap k u v
+      (Q.ginzburgBoundaryLift k φ u v ⟨Q.ginzburgCutProjection k u v c x.val,_⟩)=_
+    rw [Q.originalGinzburgLinearMap_boundaryLift,Q.ginzburgDifferential_cutProjection,hx,
+      Q.ginzburgCutProjection_on_cut k c c (Q.originalGinzburgLinearMap_cut k f.property),
+      if_pos rfl]
+
+end ASGinzburg.CutQuiver
diff --git a/ASGinzburg/GinzburgCutDegreeZero.lean b/ASGinzburg/GinzburgCutDegreeZero.lean
new file mode 100644
index 0000000..3730a61
