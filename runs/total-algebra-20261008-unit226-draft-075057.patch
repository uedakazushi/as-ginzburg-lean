--- /dev/null
+++ work/ASGinzburgDraft/ASFoundationRelationIdeal.lean
@@ -0,0 +1,52 @@
+import work.ASGinzburgDraft.ASRegularRelationRepresentatives
+import ASGinzburg.GeneratedLinearIdeals
+
+/-! The genuine two-sided unrolled path ideal generated by the actual
+sheet-zero minimal relation representatives of the original AS algebra. -/
+namespace ASGinzburg.ZAlgebra
+universe u v
+variable {k : Type u} [Field k] (A : ZAlgebra.{u,v} k) (Q : CutQuiver)
+
+noncomputable def ASRegular.foundationRelationGenerators (hAS : A.ASRegular Q)
+    (i j : ℤ) : Set ((Q.unrolledPathZAlgebra k).Hom i j) :=
+  {f | ∃ v w : Q.Vertex, ∃ hv : (v.val : ℤ)=i, ∃ hw : (w.val : ℤ)=j,
+    ∃ a : Q.FoundationRelationArrow v w,
+      (Q.unrolledPathZAlgebra k).homTransport (v.val : ℤ) (w.val : ℤ) i j hv hw
+        (hAS.foundationRelationLift A Q v w a).val=f}
+
+noncomputable def ASRegular.foundationRelationIdeal (hAS : A.ASRegular Q) :
+    (Q.unrolledPathZAlgebra k).LinearIdeal :=
+  LinearIdeal.generated (hAS.foundationRelationGenerators A Q)
+
+theorem ASRegular.foundationRelationGenerators_mem_kernel (hAS : A.ASRegular Q)
+    (i j : ℤ) : hAS.foundationRelationGenerators A Q i j ⊆
+      (hAS.unrolledPathPresentation A Q).kernel.hom i j := by
+  rintro f ⟨v,w,hv,hw,a,rfl⟩
+  subst i
+  subst j
+  exact (hAS.foundationRelationLift A Q v w a).property
+
+theorem ASRegular.foundationRelationIdeal_le_kernel (hAS : A.ASRegular Q) (i j : ℤ) :
+    (hAS.foundationRelationIdeal A Q).hom i j ≤
+      (hAS.unrolledPathPresentation A Q).kernel.hom i j :=
+  LinearIdeal.generated_le _ _ (hAS.foundationRelationGenerators_mem_kernel A Q) i j
+
+theorem ASRegular.foundationRelationLift_mem_ideal (hAS : A.ASRegular Q)
+    (i j : Q.Vertex) (a : Q.FoundationRelationArrow i j) :
+    (hAS.foundationRelationLift A Q i j a).val ∈
+      (hAS.foundationRelationIdeal A Q).hom (i.val : ℤ) (j.val : ℤ) :=
+  LinearIdeal.subset_generated _ _ _ ⟨i,j,rfl,rfl,a,rfl⟩
+
+theorem ASRegular.foundationKernel_le_ideal_mod_decomposables (hAS : A.ASRegular Q)
+    (i j : Q.Vertex) :
+    (hAS.unrolledPathPresentation A Q).kernel.hom (i.val : ℤ) (j.val : ℤ) ≤
+      (hAS.foundationRelationIdeal A Q).hom (i.val : ℤ) (j.val : ℤ) ⊔
+        Q.relationDecomposables (hAS.unrolledPathPresentation A Q).kernel
+          (i.val : ℤ) (j.val : ℤ) := by
+  rw [←hAS.foundationRelationLift_ambient_decomposition A Q i j]
+  apply sup_le_sup _ le_rfl
+  apply Submodule.span_le.mpr
+  rintro f ⟨a,rfl⟩
+  exact hAS.foundationRelationLift_mem_ideal A Q i j a
+
+end ASGinzburg.ZAlgebra
