+    (Q.ginzburgFiltrationLeftShortComplexMap k φ r f)
+    (Q.ginzburgGeneratorFilteredShortComplex_shortExact k φ y.1 v.1 r (v.2-y.2))
+    (Q.ginzburgGeneratorFilteredShortComplex_shortExact k φ x.1 v.1 r (v.2-x.2))
