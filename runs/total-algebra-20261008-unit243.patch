+++ b/ASGinzburg/ASZeroCutRingRelationGenerators.lean
@@ -0,0 +1,42 @@
+import ASGinzburg.ASZeroCutRelationComparison
+import ASGinzburg.ASFoundationRingRelationGeneration
+import ASGinzburg.FiniteComponentMapEmbeddings
+
+/-! The actual non-cut relation embeddings map exactly to the
+original finite free-path relation generators. -/
+namespace ASGinzburg.ZAlgebra
+universe u
+variable {k : Type u} [Field k] (A : ZAlgebra.{u,u} k) (Q : CutQuiver)
+
+noncomputable def ASRegular.foundationZeroCutRingRelationGenerators (hAS : A.ASRegular Q) :
+    Set (Q.ZeroCutPathRing k) :=
+  {x | ∃ i j : Q.Vertex,∃ a : Q.FoundationRelationArrow i j,
+    (Q.zeroCutPathComponentAlgebra k).totalComponent i j
+      (hAS.foundationZeroCutRelation A Q i j a)=x}
+
+theorem ASRegular.foundationZeroCutRelation_ring_comparison (hAS : A.ASRegular Q)
+    (i j : Q.Vertex) (a : Q.FoundationRelationArrow i j) :
+    Q.zeroCutFoundationRingAlgEquiv k ((Q.zeroCutPathComponentAlgebra k).totalComponent i j
+      (hAS.foundationZeroCutRelation A Q i j a))=
+      ((Q.unrolledPathZAlgebra k).foundationComponents Q).totalComponent i j
+        (hAS.foundationRelationLift A Q i j a).val := by
+  have he := (Q.zeroCutPathComponentAlgebra k).totalAlgEquivOfComponents_component
+    ((Q.unrolledPathZAlgebra k).foundationComponents Q) (Q.zeroCutFoundationComponentEquiv k)
+    (Q.zeroCutFoundationComponentEquiv_id k) (Q.zeroCutFoundationComponentEquiv_comp k)
+    i j (hAS.foundationZeroCutRelation A Q i j a)
+  exact he.trans (congrArg (((Q.unrolledPathZAlgebra k).foundationComponents Q).totalComponent i j)
+    (hAS.foundationZeroCutRelation_height A Q i j a))
+
+theorem ASRegular.foundationZeroCutRingRelationGenerators_image (hAS : A.ASRegular Q) :
+    Q.zeroCutFoundationRingAlgEquiv k '' hAS.foundationZeroCutRingRelationGenerators A Q=
+      hAS.foundationRingRelationGenerators A Q := by
+  ext x
+  constructor
+  · rintro ⟨y,⟨i,j,a,rfl⟩,rfl⟩
+    exact ⟨i,j,a,(hAS.foundationZeroCutRelation_ring_comparison A Q i j a).symm⟩
+  · rintro ⟨i,j,a,rfl⟩
+    refine ⟨(Q.zeroCutPathComponentAlgebra k).totalComponent i j
+      (hAS.foundationZeroCutRelation A Q i j a),⟨i,j,a,rfl⟩,?_⟩
+    exact hAS.foundationZeroCutRelation_ring_comparison A Q i j a
+
+end ASGinzburg.ZAlgebra
diff --git a/ASGinzburg/TwoSidedSpanRingEquiv.lean b/ASGinzburg/TwoSidedSpanRingEquiv.lean
new file mode 100644
index 0000000..a222c6b
--- /dev/null
+++ b/ASGinzburg/TwoSidedSpanRingEquiv.lean
@@ -0,0 +1,31 @@
+import Mathlib.RingTheory.TwoSidedIdeal.Operations
+
+/-! A genuine ring equivalence preserves two-sided generation by
+the actual image of the generating set. -/
+namespace ASGinzburg
+universe u v
+variable {R : Type u} [Ring R] {S : Type v} [Ring S]
+
+theorem ringEquiv_mem_twoSidedSpan_image_iff (e : R ≃+* S) (T : Set R) (x : R) :
+    e x ∈ TwoSidedIdeal.span (e '' T) ↔ x ∈ TwoSidedIdeal.span T := by
+  constructor
+  · intro hx
+    have h : TwoSidedIdeal.span (e '' T) ≤
+        (TwoSidedIdeal.span T).comap e.symm := by
+      apply TwoSidedIdeal.span_le.mpr
+      rintro y ⟨t,ht,rfl⟩
+      apply (TwoSidedIdeal.mem_comap e.symm).mpr
+      rw [e.symm_apply_apply]
+      exact TwoSidedIdeal.subset_span ht
+    have ht := (TwoSidedIdeal.mem_comap e.symm).mp (h hx)
+    rwa [e.symm_apply_apply] at ht
+  · intro hx
+    have h : TwoSidedIdeal.span T ≤
+        (TwoSidedIdeal.span (e '' T)).comap e := by
+      apply TwoSidedIdeal.span_le.mpr
+      intro t ht
+      apply (TwoSidedIdeal.mem_comap e).mpr
+      exact TwoSidedIdeal.subset_span ⟨t,ht,rfl⟩
+    exact (TwoSidedIdeal.mem_comap e).mp (h hx)
+
+end ASGinzburg
diff --git a/ASGinzburg/ASZeroCutRelationGeneration.lean b/ASGinzburg/ASZeroCutRelationGeneration.lean
new file mode 100644
index 0000000..e9f42d5
--- /dev/null
+++ b/ASGinzburg/ASZeroCutRelationGeneration.lean
@@ -0,0 +1,35 @@
+import ASGinzburg.ASZeroCutRingRelationGenerators
+import ASGinzburg.TwoSidedSpanRingEquiv
+
+/-! The actual non-cut relation ideal and presentation kernel are
+generated by the genuine finite chosen non-cut relation embeddings. -/
+namespace ASGinzburg.ZAlgebra
+universe u
+variable {k : Type u} [Field k] (A : ZAlgebra.{u,u} k) (Q : CutQuiver)
+
+theorem ASRegular.foundationZeroCutRelationIdeal_eq_span (hAS : A.ASRegular Q) :
+    hAS.foundationZeroCutRelationIdeal A Q=
+      (TwoSidedIdeal.span (hAS.foundationZeroCutRingRelationGenerators A Q)).asIdeal := by
+  ext x
+  change Q.zeroCutFoundationRingAlgEquiv k x ∈
+    (hAS.foundationRelationIdeal A Q).foundationIdeal Q ↔
+      x ∈ (TwoSidedIdeal.span (hAS.foundationZeroCutRingRelationGenerators A Q)).asIdeal
+  rw [hAS.foundationRingRelationIdeal_eq_span A Q,
+    ←hAS.foundationZeroCutRingRelationGenerators_image A Q]
+  exact ASGinzburg.ringEquiv_mem_twoSidedSpan_image_iff
+    (Q.zeroCutFoundationRingAlgEquiv k).toRingEquiv
+    (hAS.foundationZeroCutRingRelationGenerators A Q) x
+
+theorem ASRegular.foundationZeroCutKernel_eq_span (hAS : A.ASRegular Q) :
+    RingHom.ker (hAS.foundationZeroCutPresentation A Q).toRingHom=
+      (TwoSidedIdeal.span (hAS.foundationZeroCutRingRelationGenerators A Q)).asIdeal := by
+  rw [←hAS.foundationZeroCutRelationIdeal_eq_kernel A Q,hAS.foundationZeroCutRelationIdeal_eq_span A Q]
+
+noncomputable def ASRegular.foundationZeroCutGeneratedQuotientAlgEquiv (hAS : A.ASRegular Q) :
+    (Q.ZeroCutPathRing k ⧸
+      (TwoSidedIdeal.span (hAS.foundationZeroCutRingRelationGenerators A Q)).asIdeal) ≃ₐ[k]
+      A.FoundationAlgebra Q :=
+  (Ideal.quotientEquivAlgOfEq k (hAS.foundationZeroCutRelationIdeal_eq_span A Q).symm).trans
+    (hAS.foundationZeroCutQuotientAlgEquiv A Q)
+
+end ASGinzburg.ZAlgebra
diff --git a/ASGinzburg/ZeroCutJacobianRing.lean b/ASGinzburg/ZeroCutJacobianRing.lean
new file mode 100644
index 0000000..e2bc48b
--- /dev/null
+++ b/ASGinzburg/ZeroCutJacobianRing.lean
@@ -0,0 +1,35 @@
+import ASGinzburg.ZeroCutPathAlgebra
+import ASGinzburg.FiniteComponentIdempotents
+import ASGinzburg.PathCutUnrollingComparison
+import Mathlib.RingTheory.TwoSidedIdeal.Operations
+import Mathlib.RingTheory.Ideal.Quotient.Operations
+
+/-! The actual non-cut Jacobian ring is the genuine non-cut path
+ring modulo the two-sided ideal of its cut-arrow cyclic derivatives. -/
+namespace ASGinzburg.CutQuiver
+universe u
+variable (Q : CutQuiver) (k : Type u) [Field k]
+
+noncomputable def zeroCutCyclicDerivative (φ : Q.Potential k)
+    (b : {a : Q.Arrow // Q.cut a=true}) :
+    Q.pathCutComponent k (Q.target b.val) (Q.source b.val) 0 :=
+  ⟨Q.pathCyclicDerivative k b.val φ,by
+    simpa [cutDegree,b.property] using Q.pathCyclicDerivative_mem_pathCut k b.val φ⟩
+
+noncomputable def zeroCutJacobianGenerators (φ : Q.Potential k) : Set (Q.ZeroCutPathRing k) :=
+  Set.range (fun b : {a : Q.Arrow // Q.cut a=true} =>
+    (Q.zeroCutPathComponentAlgebra k).totalComponent (Q.target b.val) (Q.source b.val)
+      (Q.zeroCutCyclicDerivative k φ b))
+
+noncomputable def zeroCutJacobianIdeal (φ : Q.Potential k) : Ideal (Q.ZeroCutPathRing k) :=
+  (TwoSidedIdeal.span (Q.zeroCutJacobianGenerators k φ)).asIdeal
+
+noncomputable instance zeroCutJacobianIdealIsTwoSided (φ : Q.Potential k) :
+    (Q.zeroCutJacobianIdeal k φ).IsTwoSided := by
+  dsimp [zeroCutJacobianIdeal]
+  infer_instance
+
+noncomputable abbrev ZeroCutJacobianRing (φ : Q.Potential k) :=
+  Q.ZeroCutPathRing k ⧸ Q.zeroCutJacobianIdeal k φ
+
+end ASGinzburg.CutQuiver
diff --git a/ASGinzburg/ASFoundationJacobianRingEquiv.lean b/ASGinzburg/ASFoundationJacobianRingEquiv.lean
new file mode 100644
index 0000000..90fe617
--- /dev/null
+++ b/ASGinzburg/ASFoundationJacobianRingEquiv.lean
@@ -0,0 +1,49 @@
+import ASGinzburg.ZeroCutJacobianRing
+import ASGinzburg.ASZeroCutRelationGeneration
+import ASGinzburg.ASFoundationPotentialDerivatives
+
+/-! The original AS condition recovers the actual foundation algebra
+as the non-cut Jacobian ring of its chosen foundation potential.
+Ginzburg regularity and recovery of the whole Z-algebra remain unproved. -/
+namespace ASGinzburg.ZAlgebra
+universe u
+variable {k : Type u} [Field k] (A : ZAlgebra.{u,u} k) (Q : CutQuiver)
+
+theorem ASRegular.foundationPotential_zeroCutCyclicDerivative (hAS : A.ASRegular Q)
+    (b : {a : Q.Arrow // Q.cut a=true}) :
+    Q.zeroCutCyclicDerivative k (hAS.foundationPotential A Q) b=
+      hAS.foundationZeroCutRelation A Q (Q.target b.val) (Q.source b.val)
+        ⟨b.val,rfl,rfl,b.property⟩ := by
+  apply Subtype.ext
+  exact hAS.foundationPotential_pathCyclicDerivative A Q b
+
+theorem ASRegular.foundationPotential_zeroCutJacobianGenerators (hAS : A.ASRegular Q) :
+    hAS.foundationZeroCutRingRelationGenerators A Q=
+      Q.zeroCutJacobianGenerators k (hAS.foundationPotential A Q) := by
+  ext x
+  constructor
+  · rintro ⟨i,j,⟨a,hs,ht,hc⟩,rfl⟩
+    subst i
+    subst j
+    refine ⟨⟨a,hc⟩,?_⟩
+    exact congrArg ((Q.zeroCutPathComponentAlgebra k).totalComponent (Q.target a) (Q.source a))
+      (hAS.foundationPotential_zeroCutCyclicDerivative A Q ⟨a,hc⟩)
+  · rintro ⟨b,rfl⟩
+    refine ⟨Q.target b.val,Q.source b.val,⟨b.val,rfl,rfl,b.property⟩,?_⟩
+    exact congrArg ((Q.zeroCutPathComponentAlgebra k).totalComponent (Q.target b.val) (Q.source b.val))
+      (hAS.foundationPotential_zeroCutCyclicDerivative A Q b).symm
+
+theorem ASRegular.foundationPotential_zeroCutJacobianIdeal (hAS : A.ASRegular Q) :
+    hAS.foundationZeroCutRelationIdeal A Q=
+      Q.zeroCutJacobianIdeal k (hAS.foundationPotential A Q) := by
+  rw [hAS.foundationZeroCutRelationIdeal_eq_span A Q,
+    hAS.foundationPotential_zeroCutJacobianGenerators A Q]
+  rfl
+
+noncomputable def ASRegular.foundationJacobianRingAlgEquiv (hAS : A.ASRegular Q) :
+    Q.ZeroCutJacobianRing k (hAS.foundationPotential A Q) ≃ₐ[k]
+      A.FoundationAlgebra Q :=
+  (Ideal.quotientEquivAlgOfEq k (hAS.foundationPotential_zeroCutJacobianIdeal A Q).symm).trans
+    (hAS.foundationZeroCutQuotientAlgEquiv A Q)
+
+end ASGinzburg.ZAlgebra
