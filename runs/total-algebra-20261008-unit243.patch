+++ b/ASGinzburg/ZeroSheetPathReindexing.lean
@@ -0,0 +1,41 @@
+import ASGinzburg.UnrolledJacobianLiftIdeal
+import ASGinzburg.FoundationAlgebra
+
+/-! The native sheet-zero paths reindex to the actual finite free
+Z-algebra block, preserving path units and composition. -/
+namespace ASGinzburg.CutQuiver
+universe u
+variable (Q : CutQuiver) (k : Type u) [Field k]
+
+theorem heightEquiv_symm_vertex_zero (i : Q.Vertex) :
+    Q.heightEquiv.symm (i.val : ℤ)=(i,0) := by
+  simpa [height] using Q.heightEquiv_symm_height (i,0)
+
+noncomputable def zeroSheetPathReindexEquiv (i j : Q.Vertex) :
+    Q.UnrolledPathComponent k (i,0) (j,0) ≃ₗ[k]
+      (Q.unrolledPathZAlgebra k).Hom (i.val : ℤ) (j.val : ℤ) :=
+  Finsupp.mapDomain.linearEquiv k k (UnrolledPath.endpointEquiv Q
+    (Q.heightEquiv_symm_vertex_zero i).symm (Q.heightEquiv_symm_vertex_zero j).symm)
+
+theorem unrolledEndpointEquiv_id {v w : Q.LiftVertex} (h : v=w) :
+    Finsupp.mapDomain (UnrolledPath.endpointEquiv Q h h) (Q.unrolledPathId k v)=
+      Q.unrolledPathId k w := by
+  subst w
+  change Finsupp.mapDomain (fun p => p) (Q.unrolledPathId k v)=_
+  exact Finsupp.mapDomain_id
+
+theorem zeroSheetPathReindexEquiv_id (i : Q.Vertex) :
+    Q.zeroSheetPathReindexEquiv k i i (Q.unrolledPathId k (i,0))=
+      (Q.unrolledPathZAlgebra k).id (i.val : ℤ) :=
+  Q.unrolledEndpointEquiv_id k (Q.heightEquiv_symm_vertex_zero i).symm
+
+theorem zeroSheetPathReindexEquiv_comp {i j l : Q.Vertex}
+    (f : Q.UnrolledPathComponent k (i,0) (j,0))
+    (g : Q.UnrolledPathComponent k (j,0) (l,0)) :
+    Q.zeroSheetPathReindexEquiv k i l (Q.unrolledPathComp k g f)=
+      (Q.unrolledPathZAlgebra k).comp (Q.zeroSheetPathReindexEquiv k j l g)
+        (Q.zeroSheetPathReindexEquiv k i j f) :=
+  Q.unrolledEndpointEquiv_comp k (Q.heightEquiv_symm_vertex_zero i).symm
+    (Q.heightEquiv_symm_vertex_zero j).symm (Q.heightEquiv_symm_vertex_zero l).symm f g
+
+end ASGinzburg.CutQuiver
diff --git a/ASGinzburg/FiniteComponentAlgebraMaps.lean b/ASGinzburg/FiniteComponentAlgebraMaps.lean
new file mode 100644
index 0000000..8a6e397
--- /dev/null
+++ b/ASGinzburg/FiniteComponentAlgebraMaps.lean
@@ -0,0 +1,64 @@
+import ASGinzburg.FiniteComponentAlgebra
+
+/-! Genuine componentwise unit- and composition-preserving maps
+induce maps and isomorphisms of finite convolution algebras. -/
+namespace ASGinzburg.LinearComponentAlgebra
+universe u v
+variable {k : Type u} [Field k] {ι : Type v} [Fintype ι]
+  (B C : LinearComponentAlgebra k ι)
+
+noncomputable def totalLinearMapOfComponents
+    (f : ∀ i j,B.Hom i j →ₗ[k] C.Hom i j) : B.Total →ₗ[k] C.Total where
+  toFun x i j := f i j (x i j)
+  map_add' x y := by funext i j; exact (f i j).map_add (x i j) (y i j)
+  map_smul' c x := by funext i j; exact (f i j).map_smul c (x i j)
+
+omit [Fintype ι] in
+theorem totalLinearMapOfComponents_one
+    (f : ∀ i j,B.Hom i j →ₗ[k] C.Hom i j) (hid : ∀ i,f i i (B.id i)=C.id i) :
+    B.totalLinearMapOfComponents C f 1=1 := by
+  classical
+  funext i j
+  change f i j (B.totalOne i j)=C.totalOne i j
+  by_cases h : i=j
+  · subst j
+    rw [B.totalOne_diag,C.totalOne_diag]
+    exact hid i
+  · rw [B.totalOne_offdiag h,C.totalOne_offdiag h,map_zero]
+
+theorem totalLinearMapOfComponents_mul
+    (f : ∀ i j,B.Hom i j →ₗ[k] C.Hom i j)
+    (hmul : ∀ {i j l} (x : B.Hom i j) (y : B.Hom j l),
+      f i l (B.comp y x)=C.comp (f j l y) (f i j x)) (x y : B.Total) :
+    B.totalLinearMapOfComponents C f (x*y)=
+      B.totalLinearMapOfComponents C f x*B.totalLinearMapOfComponents C f y := by
+  funext i l
+  change f i l (∑ j : ι,B.comp (x j l) (y i j))=
+    ∑ j : ι,C.comp (f j l (x j l)) (f i j (y i j))
+  rw [map_sum]
+  apply Finset.sum_congr rfl
+  intro j _
+  exact hmul (y i j) (x j l)
+
+noncomputable def totalAlgHomOfComponents
+    (f : ∀ i j,B.Hom i j →ₗ[k] C.Hom i j) (hid : ∀ i,f i i (B.id i)=C.id i)
+    (hmul : ∀ {i j l} (x : B.Hom i j) (y : B.Hom j l),
+      f i l (B.comp y x)=C.comp (f j l y) (f i j x)) : B.Total →ₐ[k] C.Total :=
+  AlgHom.ofLinearMap (B.totalLinearMapOfComponents C f)
+    (B.totalLinearMapOfComponents_one C f hid) (B.totalLinearMapOfComponents_mul C f hmul)
+
+noncomputable def totalAlgEquivOfComponents
+    (e : ∀ i j,B.Hom i j ≃ₗ[k] C.Hom i j) (hid : ∀ i,e i i (B.id i)=C.id i)
+    (hmul : ∀ {i j l} (x : B.Hom i j) (y : B.Hom j l),
+      e i l (B.comp y x)=C.comp (e j l y) (e i j x)) : B.Total ≃ₐ[k] C.Total :=
+  AlgEquiv.ofBijective (B.totalAlgHomOfComponents C (fun i j => (e i j).toLinearMap) hid hmul)
+    ⟨by
+      intro x y h
+      funext i j
+      exact (e i j).injective (congrFun (congrFun h i) j),by
+      intro y
+      refine ⟨fun i j => (e i j).symm (y i j),?_⟩
+      funext i j
+      exact (e i j).apply_symm_apply (y i j)⟩
+
+end ASGinzburg.LinearComponentAlgebra
diff --git a/ASGinzburg/ZeroCutFoundationRingEquiv.lean b/ASGinzburg/ZeroCutFoundationRingEquiv.lean
new file mode 100644
index 0000000..1b7e54b
--- /dev/null
+++ b/ASGinzburg/ZeroCutFoundationRingEquiv.lean
@@ -0,0 +1,42 @@
+import ASGinzburg.ZeroCutUnrollingProducts
+import ASGinzburg.ZeroSheetPathReindexing
+import ASGinzburg.FiniteComponentAlgebraMaps
+
+/-! The actual non-cut path ring is isomorphic to the actual
+sheet-zero free-path foundation ring, preserving all original products. -/
+namespace ASGinzburg.CutQuiver
+universe u
+variable (Q : CutQuiver) (k : Type u) [Field k]
+
+noncomputable def zeroCutFoundationComponentEquiv (i j : Q.Vertex) :
+    Q.pathCutComponent k i j 0 ≃ₗ[k]
+      (Q.unrolledPathZAlgebra k).Hom (i.val : ℤ) (j.val : ℤ) :=
+  (Q.zeroCutNativeUnrollingEquiv k i j).trans (Q.zeroSheetPathReindexEquiv k i j)
+
+theorem zeroCutFoundationComponentEquiv_id (i : Q.Vertex) :
+    Q.zeroCutFoundationComponentEquiv k i i (Q.zeroCutPathId k i)=
+      (Q.unrolledPathZAlgebra k).id (i.val : ℤ) := by
+  change Q.zeroSheetPathReindexEquiv k i i
+    (Q.zeroCutNativeUnrollingEquiv k i i (Q.zeroCutPathId k i))=_
+  rw [Q.zeroCutNativeUnrollingEquiv_id,Q.zeroSheetPathReindexEquiv_id]
+
+theorem zeroCutFoundationComponentEquiv_comp {i j l : Q.Vertex}
+    (f : Q.pathCutComponent k i j 0) (g : Q.pathCutComponent k j l 0) :
+    Q.zeroCutFoundationComponentEquiv k i l (Q.zeroCutPathComp k g f)=
+      (Q.unrolledPathZAlgebra k).comp (Q.zeroCutFoundationComponentEquiv k j l g)
+        (Q.zeroCutFoundationComponentEquiv k i j f) := by
+  change Q.zeroSheetPathReindexEquiv k i l
+    (Q.zeroCutNativeUnrollingEquiv k i l (Q.zeroCutPathComp k g f))=_
+  rw [Q.zeroCutNativeUnrollingEquiv_comp,Q.zeroSheetPathReindexEquiv_comp]
+  rfl
+
+noncomputable def zeroCutFoundationRingAlgEquiv :
+    Q.ZeroCutPathRing k ≃ₐ[k] (Q.unrolledPathZAlgebra k).FoundationAlgebra Q :=
+  (Q.zeroCutPathComponentAlgebra k).totalAlgEquivOfComponents
+    ((Q.unrolledPathZAlgebra k).foundationComponents Q) (Q.zeroCutFoundationComponentEquiv k)
+    (Q.zeroCutFoundationComponentEquiv_id k) (Q.zeroCutFoundationComponentEquiv_comp k)
+
+theorem zeroCutFoundationRingAlgEquiv_apply (x : Q.ZeroCutPathRing k) (i j : Q.Vertex) :
+    Q.zeroCutFoundationRingAlgEquiv k x i j=Q.zeroCutFoundationComponentEquiv k i j (x i j) := rfl
+
+end ASGinzburg.CutQuiver
diff --git a/ASGinzburg/ASFoundationZeroCutPresentation.lean b/ASGinzburg/ASFoundationZeroCutPresentation.lean
new file mode 100644
index 0000000..3ecb4ed
--- /dev/null
+++ b/ASGinzburg/ASFoundationZeroCutPresentation.lean
@@ -0,0 +1,49 @@
+import ASGinzburg.ZeroCutFoundationRingEquiv
+import ASGinzburg.ASFoundationRelationRingQuotient
+
+/-! The original AS foundation ring is a quotient of the actual
+non-cut path ring by the transported genuine minimal relation ideal.
+Identifying this ideal as generated by cut derivatives is a further proof. -/
+namespace ASGinzburg.ZAlgebra
+universe u
+variable {k : Type u} [Field k] (A : ZAlgebra.{u,u} k) (Q : CutQuiver)
+
+noncomputable def ASRegular.foundationZeroCutPresentation (hAS : A.ASRegular Q) :
+    Q.ZeroCutPathRing k →ₐ[k] A.FoundationAlgebra Q :=
+  (hAS.foundationRingPresentation A Q).comp (Q.zeroCutFoundationRingAlgEquiv k).toAlgHom
+
+theorem ASRegular.foundationZeroCutPresentation_surjective (hAS : A.ASRegular Q) :
+    Function.Surjective (hAS.foundationZeroCutPresentation A Q) :=
+  (hAS.foundationRingPresentation_surjective A Q).comp (Q.zeroCutFoundationRingAlgEquiv k).surjective
+
+noncomputable def ASRegular.foundationZeroCutRelationIdeal (hAS : A.ASRegular Q) :
+    Ideal (Q.ZeroCutPathRing k) :=
+  Ideal.comap (Q.zeroCutFoundationRingAlgEquiv k).toRingHom
+    ((hAS.foundationRelationIdeal A Q).foundationIdeal Q)
+
+theorem ASRegular.foundationZeroCutRelationIdeal_eq_kernel (hAS : A.ASRegular Q) :
+    hAS.foundationZeroCutRelationIdeal A Q=
+      RingHom.ker (hAS.foundationZeroCutPresentation A Q).toRingHom := by
+  rw [ASRegular.foundationZeroCutRelationIdeal,hAS.foundationRelationRingIdeal_eq_kernel A Q]
+  rfl
+
+noncomputable instance ASRegular.foundationZeroCutRelationIdealIsTwoSided (hAS : A.ASRegular Q) :
+    (hAS.foundationZeroCutRelationIdeal A Q).IsTwoSided := by
+  rw [hAS.foundationZeroCutRelationIdeal_eq_kernel A Q]
+  infer_instance
+
+noncomputable def ASRegular.foundationZeroCutQuotientAlgEquiv (hAS : A.ASRegular Q) :
+    (Q.ZeroCutPathRing k ⧸ hAS.foundationZeroCutRelationIdeal A Q) ≃ₐ[k] A.FoundationAlgebra Q :=
+  (Ideal.quotientEquivAlgOfEq k (hAS.foundationZeroCutRelationIdeal_eq_kernel A Q)).trans
+    (Ideal.quotientKerAlgEquivOfSurjective (hAS.foundationZeroCutPresentation_surjective A Q))
+
+theorem ASRegular.foundationZeroCutQuotientAlgEquiv_apply_mk (hAS : A.ASRegular Q)
+    (x : Q.ZeroCutPathRing k) :
+    hAS.foundationZeroCutQuotientAlgEquiv A Q
+      (Ideal.Quotient.mk (hAS.foundationZeroCutRelationIdeal A Q) x)=
+      hAS.foundationZeroCutPresentation A Q x := by
+  rw [ASRegular.foundationZeroCutQuotientAlgEquiv,AlgEquiv.trans_apply,
+    Ideal.quotientEquivAlgOfEq_mk]
+  rfl
+
+end ASGinzburg.ZAlgebra
diff --git a/ASGinzburg/ASZeroCutRelationComparison.lean b/ASGinzburg/ASZeroCutRelationComparison.lean
