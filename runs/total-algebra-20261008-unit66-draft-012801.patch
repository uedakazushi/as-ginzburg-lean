+import work.ASGinzburgDraft.OppositeGinzburgGeneratorDifferential
+
+/-! Endpoint transport commutes with the actual differential. This turns
+the proved generator formula into a formula on genuine arrow-path elements. -/
+namespace ASGinzburg.CutQuiver
+universe u
+variable (Q : CutQuiver) (k : Type u) [Field k]
+
+theorem ginzburgDifferential_transport (φ : Q.Potential k) {u v u' v' : Q.Vertex}
+    (hu : u = u') (hv : v = v') (f : Q.GinzburgPathComponent k u v) :
+    Q.ginzburgDifferential k φ u' v' (Q.transportGinzburgPathComponent k hu hv f) =
+      Q.transportGinzburgPathComponent k hu hv (Q.ginzburgDifferential k φ u v f) := by
+  subst u' v'
+  rfl
+
+theorem ginzburgArrowPath_opposite (a : Q.GinzburgArrow) :
+    (Q.ginzburgArrowPath a).opposite =
+      (Q.opposite.ginzburgArrowPath a.opposite).transport Q.opposite
+        a.opposite_source a.opposite_target := by
+  apply GinzburgPath.toList_injective (Q := Q.opposite) (a.target Q).rev (a.source Q).rev
+  simp [ginzburgArrowPath, GinzburgPath.opposite_toList, GinzburgPath.toList]
+
+theorem oppositeGinzburgPathComponentEquiv_arrowDifferential
+    (φ : Q.Potential k) (a : Q.GinzburgArrow) :
+    Q.oppositeGinzburgPathComponentEquiv k (a.source Q) (a.target Q)
+        (Q.ginzburgDifferential k φ (a.source Q) (a.target Q)
+          (Finsupp.single (Q.ginzburgArrowPath a) 1)) =
+      ginzburgSign k (a.cohomologicalDegree Q + 1) •
+        Q.opposite.ginzburgDifferential k (Q.oppositePotentialEquiv k φ)
+          (a.target Q).rev (a.source Q).rev
+          (Q.oppositeGinzburgPathComponentEquiv k (a.source Q) (a.target Q)
+            (Finsupp.single (Q.ginzburgArrowPath a) 1)) := by
+  rw [Q.ginzburgDifferential_generator,
+    Q.oppositeGinzburgPathComponentEquiv_generatorDifferential,
+    Q.oppositeGinzburgPathComponentEquiv_single, Q.ginzburgArrowPath_opposite,
+    ← Q.opposite.transportGinzburgPathComponent_single,
+    Q.opposite.ginzburgDifferential_transport, Q.opposite.ginzburgDifferential_generator]
+
+end ASGinzburg.CutQuiver
