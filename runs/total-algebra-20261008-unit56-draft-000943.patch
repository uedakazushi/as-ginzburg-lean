+
+noncomputable def ginzburgAugmentationLeftHomology (φ : Q.Potential k)
+    {x y v : Q.LiftVertex} (q : ℤ)
+    (f : Q.ginzburgCutCohomologicalComponent k x.1 y.1 0 (y.2-x.2)) :
+    Q.ginzburgAugmentationHomology k φ y.1 v.1 (v.2-y.2) q ⟶
