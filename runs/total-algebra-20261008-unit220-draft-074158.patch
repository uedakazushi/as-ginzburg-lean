--- /dev/null
+++ work/ASGinzburgDraft/RelationClosedTraceDerivative.lean
@@ -0,0 +1,34 @@
+import work.ASGinzburgDraft.RelationClosedTrace
+import work.ASGinzburgDraft.CutCyclicDerivativeDelta
+import ASGinzburg.PathCutGrading
+
+/-! Cut cyclic derivatives of actual closed relation traces recover
+the non-cut relation at its own cut arrow and vanish at other cut arrows. -/
+namespace ASGinzburg.CutQuiver
+universe u
+variable (Q : CutQuiver) (k : Type u) [Field k]
+
+theorem cyclicDerivative_relationClosedTrace_cut (a b : Q.Arrow) (hb : Q.cut b=true)
+    {r : Q.PathComponent k (Q.target a) (Q.source a)}
+    (hr : r ∈ Q.pathCutComponent k (Q.target a) (Q.source a) 0) :
+    cyclicDerivative b (Q.relationClosedTrace k a r)=
+      if b=a then Q.pathWordMap k (Q.target a) (Q.source a) r else 0 := by
+  change r ∈ Finsupp.supported k k _ at hr
+  rw [Finsupp.supported_eq_span_single] at hr
+  induction hr using Submodule.span_induction with
+  | mem x hx =>
+    obtain ⟨p,hp,rfl⟩ := hx
+    have hc : p.cutDegree=0 := by exact_mod_cast hp
+    have hw : wordCutDegree Q.cut p.toList=0 := by rw [path_word_cutDegree,hc]
+    rw [Q.relationClosedTrace_single,one_smul,cyclicDerivative_traceWord,
+      derivativeWord_cut_cons Q.cut a b hb p.toList hw]
+    simp [pathWordMap,Finsupp.mapDomain_single]
+  | zero => simp
+  | add x y hx hy ihx ihy =>
+    simp only [map_add,ihx,ihy]
+    split_ifs <;> simp
+  | smul c x hx ih =>
+    simp only [map_smul,ih]
+    split_ifs <;> simp
+
+end ASGinzburg.CutQuiver
