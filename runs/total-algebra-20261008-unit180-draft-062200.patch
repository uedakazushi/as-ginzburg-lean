--- /dev/null
+++ work/ASGinzburgDraft/MinimalRelationBasisLifts.lean
@@ -0,0 +1,52 @@
+import work.ASGinzburgDraft.MinimalRelationComponents
+
+/-! Any actual basis of I/(IJ+JI) has actual relation representatives
+and generates I modulo decomposable relations. AS conditions still have
+to identify the prescribed cut-arrow basis of this genuine quotient. -/
+namespace ASGinzburg.CutQuiver
+universe u w
+variable (Q : CutQuiver) {k : Type u} [Field k]
+  (I : (Q.unrolledPathZAlgebra k).LinearIdeal) (i j : ℤ)
+
+noncomputable def minimalRelationBasisLift {ι : Type w}
+    (b : Module.Basis ι k (Q.MinimalRelationComponent I i j)) (a : ι) : I.hom i j :=
+  Classical.choose ((Submodule.comap (I.hom i j).subtype (Q.relationDecomposables I i j)).mkQ_surjective
+    (b a))
+
+theorem minimalRelationBasisLift_class {ι : Type w}
+    (b : Module.Basis ι k (Q.MinimalRelationComponent I i j)) (a : ι) :
+    (Submodule.Quotient.mk (Q.minimalRelationBasisLift I i j b a) :
+      Q.MinimalRelationComponent I i j)=b a :=
+  Classical.choose_spec ((Submodule.comap (I.hom i j).subtype
+    (Q.relationDecomposables I i j)).mkQ_surjective (b a))
+
+set_option synthInstance.maxHeartbeats 200000 in
+theorem minimalRelationBasisLift_decomposition {ι : Type w}
+    (b : Module.Basis ι k (Q.MinimalRelationComponent I i j)) :
+    Submodule.span k (Set.range (Q.minimalRelationBasisLift I i j b)) ⊔
+      Submodule.comap (I.hom i j).subtype (Q.relationDecomposables I i j)=⊤ := by
+  let p : Submodule k (I.hom i j) :=
+    Submodule.comap (I.hom i j).subtype (Q.relationDecomposables I i j)
+  letI : AddCommGroup (I.hom i j) := inferInstance
+  letI : Module k (I.hom i j) := inferInstance
+  have hm : Submodule.map p.mkQ
+      (Submodule.span k (Set.range (Q.minimalRelationBasisLift I i j b)))=⊤ := by
+    rw [Submodule.map_span,←Set.range_comp]
+    have h : p.mkQ ∘ Q.minimalRelationBasisLift I i j b=b := by
+      funext a
+      exact Q.minimalRelationBasisLift_class I i j b a
+    rw [h,b.span_eq]
+  simpa only [sup_comm] using (p.map_mkQ_eq_top _).mp hm
+
+theorem minimalRelationBasisLift_ambient_decomposition {ι : Type w}
+    (b : Module.Basis ι k (Q.MinimalRelationComponent I i j)) :
+    Submodule.span k (Set.range (fun a => (Q.minimalRelationBasisLift I i j b a).val)) ⊔
+      Q.relationDecomposables I i j=I.hom i j := by
+  have h := congrArg (Submodule.map (I.hom i j).subtype)
+    (Q.minimalRelationBasisLift_decomposition I i j b)
+  rw [Submodule.map_sup,Submodule.map_span,Submodule.map_comap_subtype,
+    inf_eq_right.mpr (Q.relationDecomposables_le I i j),Submodule.map_top,
+    Submodule.range_subtype,←Set.range_comp] at h
+  exact h
+
+end ASGinzburg.CutQuiver
