+theorem rightModule_isZero_of_components (M : A.RightModule)
+    (h : ∀ i : ℤ, IsZero ((A.rightModuleEvaluation i).obj M)) : IsZero M := by
+  rw [IsZero.iff_id_eq_zero]
+  apply NatTrans.ext
+  funext X
+  exact (h X.unop.index).eq_of_src _ _
