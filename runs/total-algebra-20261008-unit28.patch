+    (h₄ : ∀ i, ∀ e : Abelian.Ext.{v} S.X₃ (A.leftRepresentable i) 4, e = 0) :
+    (A.leftModuleExtRightShortComplex S 3).ShortExact where
+  exact := A.leftModuleExtRightShortComplex_exact hS 3
+  mono_f := by
