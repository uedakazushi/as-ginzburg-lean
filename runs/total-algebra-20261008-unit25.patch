+namespace ASGinzburg.ZAlgebra.ASResolution
+open CategoryTheory CategoryTheory.Limits
+open scoped ZeroObject
+universe u v
+variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k} {Q : CutQuiver}
+  {w : Q.LiftVertex} (R : A.ASResolution Q w)
+
+theorem leftResolutionTermFiniteProjective (n : ℕ) :
+    A.leftFiniteProjectiveProperty (R.leftResolutionTerm n) := by
+  rcases n with _ | _ | _ | _ | n
+  · exact A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 3)
+  · exact A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 2)
+  · exact A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 1)
+  · exact A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 0)
+  · exact A.leftFiniteProjectiveProperty_of_isZero (isZero_zero A.LeftModule)
+
+theorem leftResolutionComplex_isZero_ge_four (n : ℕ) :
+    IsZero (R.leftResolutionComplex.X (n+4)) := by
+  change IsZero (R.leftResolutionTerm (n+4))
+  exact isZero_zero A.LeftModule
+end ASGinzburg.ZAlgebra.ASResolution
