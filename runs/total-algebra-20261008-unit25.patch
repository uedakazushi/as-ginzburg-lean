+namespace ASGinzburg.ZAlgebra.ASRegular
+open CategoryTheory
+universe u v
+variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k} {Q : CutQuiver}
+
+noncomputable def leftSimpleProjectiveResolution (h : A.ASRegular Q) (u : Q.LiftVertex) :
+    ProjectiveResolution (A.simpleLeftModule (Q.height u)) := by
+  simpa only [Equiv.symm_apply_apply] using (h.resolution A Q (Q.tau u)).toLeftProjectiveResolution h
+end ASGinzburg.ZAlgebra.ASRegular
