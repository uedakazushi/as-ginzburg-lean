+namespace ASGinzburg.ZAlgebra.ASResolution
+open CategoryTheory CategoryTheory.Limits
+universe u v
+variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k} {Q : CutQuiver}
+  {w : Q.LiftVertex} (R : A.ASResolution Q w) (h : A.ASRegular Q)
+
+noncomputable def leftResolutionProjection : R.leftResolutionTerm 0 ⟶
+    A.simpleLeftModule (Q.height (Q.tau.symm w)) :=
+  R.dualTopProjection ≫ (h.extLeftThreeIsoSimple A Q w).hom
+
+noncomputable instance leftResolutionProjectionEpi : Epi (R.leftResolutionProjection h) := by
+  dsimp [leftResolutionProjection]
+  infer_instance
+
+theorem leftResolutionProjection_differential :
+    R.leftResolutionDifferential 0 ≫ R.leftResolutionProjection h = 0 := by
+  change A.rightModuleADualMap R.d₃ ≫ (R.dualTopProjection ≫ _) = 0
+  rw [← Category.assoc, R.dualTopProjection_dual_d₃, zero_comp]
+
+theorem leftResolutionProjection_exact :
+    (ShortComplex.mk (R.leftResolutionDifferential 0) (R.leftResolutionProjection h)
+      (R.leftResolutionProjection_differential h)).Exact := by
+  let e := h.extLeftThreeIsoSimple A Q w
+  let T := ShortComplex.mk (A.rightModuleADualMap R.d₃) R.dualTopProjection R.dualTopProjection_dual_d₃
+  let eS : ShortComplex.mk (R.leftResolutionDifferential 0) (R.leftResolutionProjection h)
+      (R.leftResolutionProjection_differential h) ≅ T :=
+    ShortComplex.isoMk (Iso.refl _) (Iso.refl _) e.symm
+      (by simp [T,leftResolutionDifferential])
+      (by simp [T,leftResolutionProjection,e,Category.assoc])
+  exact (ShortComplex.exact_iff_of_iso eS).mpr R.dualTopProjection_exact
+
+noncomputable def leftResolutionAugmentation : R.leftResolutionComplex ⟶
+    (ChainComplex.single₀ A.LeftModule).obj (A.simpleLeftModule (Q.height (Q.tau.symm w))) :=
+  (ChainComplex.toSingle₀Equiv _ _).symm ⟨R.leftResolutionProjection h, by
+    rw [show R.leftResolutionComplex.d 1 0 = R.leftResolutionDifferential 0 from
+      ChainComplex.of_d _ _ _ 0]
+    exact R.leftResolutionProjection_differential h⟩
+
+noncomputable instance leftResolutionAugmentationQuasiIso : QuasiIso (R.leftResolutionAugmentation h) := ⟨fun n => by
+  cases n
+  · rw [ChainComplex.quasiIsoAt₀_iff, ShortComplex.quasiIso_iff_of_zeros']
+    · dsimp
+      refine (ShortComplex.exact_and_epi_g_iff_of_iso ?_).2
+        ⟨R.leftResolutionProjection_exact h, by infer_instance⟩
+      exact ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _)
+        (by dsimp; exact (ChainComplex.of_d R.leftResolutionTerm R.leftResolutionDifferential
+          R.leftResolutionDifferential_sq 0).symm) (by simp [leftResolutionAugmentation])
+    all_goals rfl
+  · rw [quasiIsoAt_iff_exactAt']
+    · exact R.leftResolutionComplex_exactAt_succ h _
+    · exact ChainComplex.exactAt_succ_single_obj _ _⟩
+
+noncomputable def toLeftProjectiveResolution :
+    ProjectiveResolution (A.simpleLeftModule (Q.height (Q.tau.symm w))) where
+  complex := R.leftResolutionComplex
+  projective n := by change Projective (R.leftResolutionTerm n); infer_instance
+  π := R.leftResolutionAugmentation h
+  quasiIso := R.leftResolutionAugmentationQuasiIso h
+end ASGinzburg.ZAlgebra.ASResolution
