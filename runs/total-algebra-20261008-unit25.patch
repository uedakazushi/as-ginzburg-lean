+namespace ASGinzburg.ZAlgebra.ASResolution
+open CategoryTheory CategoryTheory.Limits
+universe u v
+variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k} {Q : CutQuiver}
+  {w : Q.LiftVertex} (R : A.ASResolution Q w)
+
+theorem dual_d₁_mono (h : A.ASRegular Q) : Mono (A.rightModuleADualMap R.d₁) := by
+  have he := R.dualComplex_exactAt_low h 0 (by decide)
+  rw [HomologicalComplex.exactAt_iff' _ 0 0 1 (by simp) (by simp)] at he
+  have hf : (R.dualComplex.sc' 0 0 1).f = 0 := R.dualComplex.shape 0 0 (by simp)
+  have hm : Mono (R.dualComplex.d 0 1) := (ShortComplex.exact_iff_mono _ hf).mp he
+  rw [R.dualComplex_d 0] at hm
+  exact hm
+
+theorem leftResolutionComplex_exactAt_succ (h : A.ASRegular Q) (n : ℕ) :
+    R.leftResolutionComplex.ExactAt (n+1) := by
+  rw [HomologicalComplex.exactAt_iff' _ (n+2) (n+1) n (by simp) (by simp)]
+  rcases n with _ | _ | _ | n
+  · have he := R.dualComplex_exactAt_low h 2 (by decide)
+    rw [HomologicalComplex.exactAt_iff' _ 1 2 3 (by simp) (by simp)] at he
+    simp only [HomologicalComplex.sc'] at he
+    simpa [leftResolutionComplex, leftResolutionTerm, leftResolutionDifferential,
+      HomologicalComplex.sc', complexDifferential] using he
+  · have he := R.dualComplex_exactAt_low h 1 (by decide)
+    rw [HomologicalComplex.exactAt_iff' _ 0 1 2 (by simp) (by simp)] at he
+    simp only [HomologicalComplex.sc'] at he
+    simpa [leftResolutionComplex, leftResolutionTerm, leftResolutionDifferential,
+      HomologicalComplex.sc', complexDifferential] using he
+  · letI := R.dual_d₁_mono h
+    apply (ShortComplex.exact_iff_mono _ ?_).mpr
+    · change Mono (R.leftResolutionComplex.d 3 2)
+      rw [show R.leftResolutionComplex.d 3 2 = A.rightModuleADualMap R.d₁ from
+        ChainComplex.of_d _ _ _ 2]
+      infer_instance
+    · change R.leftResolutionComplex.d 4 3 = 0
+      exact ChainComplex.of_d _ _ _ 3
+  · apply ShortComplex.exact_of_isZero_X₂
+    change IsZero (R.leftResolutionTerm (n+4))
+    exact isZero_zero A.LeftModule
+end ASGinzburg.ZAlgebra.ASResolution
