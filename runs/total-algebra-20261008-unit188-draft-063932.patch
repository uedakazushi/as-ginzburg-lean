--- /dev/null
+++ work/ASGinzburgDraft/ASLastArrowRelationSpan.lean
@@ -0,0 +1,50 @@
+import work.ASGinzburgDraft.ASLastArrowKernelCoordinates
+
+/-! The actual cover kernel is generated by relations extended by one
+last arrow. This gives an explicit denominator, to be identified with
+the genuine ideal product IJ. -/
+namespace ASGinzburg.ZAlgebra
+universe u v
+variable {k : Type u} [Field k] (A : ZAlgebra.{u,v} k) (Q : CutQuiver)
+  (R : ∀ w : Q.LiftVertex, A.ASResolution Q w)
+
+def lastArrowRelationGenerators (u w : Q.LiftVertex) : Set (Q.UnrolledPathComponent k u w) :=
+  {f | ∃ a : Q.incomingArrows w,
+    ∃ p : Q.UnrolledPathComponent k u (Q.incomingSource w a),
+      A.unrolledPathLinearEvaluation Q R u (Q.incomingSource w a) p=0 ∧
+        p.mapDomain (CutQuiver.UnrolledPath.snoc a)=f}
+
+def lastArrowRelationSpan (u w : Q.LiftVertex) : Submodule k (Q.UnrolledPathComponent k u w) :=
+  Submodule.span k (A.lastArrowRelationGenerators Q R u w)
+
+theorem lastArrow_prefix_relation_mem_ker (u w : Q.LiftVertex) (huw : u≠w)
+    (a : Q.incomingArrows w) (p : Q.UnrolledPathComponent k u (Q.incomingSource w a))
+    (hp : A.unrolledPathLinearEvaluation Q R u (Q.incomingSource w a) p=0) :
+    p.mapDomain (CutQuiver.UnrolledPath.snoc a)∈
+      LinearMap.ker (A.lastArrowToASFirstTerm Q R u w huw) := by
+  classical
+  apply (A.lastArrowToASFirstTerm_eq_zero_iff Q R u w huw _).mpr
+  intro b
+  rw [←Q.unrolledLastArrowLinearEquiv_symm_single k u w huw a p,
+    LinearEquiv.apply_symm_apply]
+  by_cases h : b=a
+  · subst b
+    simpa using hp
+  · simp [h]
+
+theorem lastArrowRelationSpan_eq_cover_ker (u w : Q.LiftVertex) (huw : u≠w) :
+    A.lastArrowRelationSpan Q R u w=LinearMap.ker (A.lastArrowToASFirstTerm Q R u w huw) := by
+  classical
+  apply le_antisymm
+  · apply Submodule.span_le.mpr
+    rintro f ⟨a,p,hp,rfl⟩
+    exact A.lastArrow_prefix_relation_mem_ker Q R u w huw a p hp
+  · intro f hf
+    rw [Q.unrolledLastArrow_reconstruction k u w huw f]
+    apply (A.lastArrowRelationSpan Q R u w).sum_mem
+    intro a _
+    apply Submodule.subset_span
+    exact ⟨a,Q.unrolledLastArrowLinearEquiv k u w huw f a,
+      (A.lastArrowToASFirstTerm_eq_zero_iff Q R u w huw f).mp hf a,rfl⟩
+
+end ASGinzburg.ZAlgebra
