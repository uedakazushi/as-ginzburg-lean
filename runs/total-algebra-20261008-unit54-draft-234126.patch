+    (f : Q.ginzburgCutCohomologicalComponent k u v 0 c) :
+    (Q.ginzburgCutZeroEquivOfCutEq k u v c d h f).val=f.val := by
+  cases h
+  rfl
+
+theorem ginzburgCutZeroQuotientEquivOfCutEq_mk (φ : Q.Potential k)
+    (u v : Q.Vertex) (c d : ℤ) (h : c=d)
