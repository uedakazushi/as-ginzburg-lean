--- /dev/null
+++ work/ASGinzburgDraft/GinzburgProjectiveConnectingClasses.lean
@@ -0,0 +1,67 @@
+import work.ASGinzburgDraft.GinzburgDualOriginalClassFormula
+import ASGinzburg.GinzburgProjectiveConnectingMaps
+
+/-! Actual quotient cycle representatives determine the native
+projective dual-to-original differential and all its component values. -/
+namespace ASGinzburg.CutQuiver
+open CategoryTheory
+universe u
+variable (Q : CutQuiver) (k : Type u) [Field k]
+
+noncomputable def ginzburgDualCoefficientClass (φ : Q.Potential k)
+    (x v : Q.LiftVertex)
+    (f : Q.ginzburgGeneratorFiltrationAtDegree k x.1 v.1 (-1) (-1) (v.2-x.2)) :
+    ((Q.unrolledJacobianZAlgebra k φ).rightModuleEvaluation (Q.height x)).obj
+      ((Q.unrolledJacobianZAlgebra k φ).ginzburgGeneratorCoefficientModule Q v (-1)) :=
+  (Q.ginzburgLayerProjectiveComponentIso k φ x v (-1)).hom
+    (moduleCochainHomologyClass
+      (Q.ginzburgAssociatedGradedComplex k φ x.1 v.1 (-1) (v.2-x.2)) (-1)
+      (Submodule.Quotient.mk f)
+      (Q.ginzburgDualLayerQuotient_cycle k φ x.1 v.1 (v.2-x.2) f))
+
+noncomputable def ginzburgOriginalDifferentialCoefficients (φ : Q.Potential k)
+    (x v : Q.LiftVertex)
+    (f : Q.ginzburgGeneratorFiltrationAtDegree k x.1 v.1 (-1) (-1) (v.2-x.2)) :
+    Π a : {a : Q.GinzburgArrow // a.target Q=v.1 ∧ a.cohomologicalDegree Q=0},
+      (Q.unrolledJacobianZAlgebra k φ).Hom (Q.height x)
+        (Q.height (Q.ginzburgPrefixGeneratorEndpoint v a.val)) :=
+  Q.ginzburgPrefixTopFixedUnrolledEquiv k φ x v 0
+    (Submodule.Quotient.mk
+      ((Q.ginzburgOriginalFilteredToPrefix k φ x.1 v.1 (v.2-x.2)).f 0
+        (Q.ginzburgDualLayerDifferential k φ x.1 v.1 (v.2-x.2) f)))
+
+set_option maxRecDepth 2000 in
+theorem ginzburgDualOriginalProjectiveComponent_class
+    (φ : Q.Potential k) (x v : Q.LiftVertex)
+    (f : Q.ginzburgGeneratorFiltrationAtDegree k x.1 v.1 (-1) (-1) (v.2-x.2)) :
+    (Q.unrolledJacobianZAlgebra k φ).ginzburgGeneratorCoefficientComponentEquiv Q v 0
+      (Q.height x) (Q.ginzburgDualOriginalProjectiveComponent k φ x v
+        (Q.ginzburgDualCoefficientClass k φ x v f))=
+      Q.ginzburgOriginalDifferentialCoefficients k φ x v f := by
+  let y := moduleCochainHomologyClass
+    (Q.ginzburgAssociatedGradedComplex k φ x.1 v.1 (-1) (v.2-x.2)) (-1)
+    (Submodule.Quotient.mk f) (Q.ginzburgDualLayerQuotient_cycle k φ x.1 v.1 (v.2-x.2) f)
+  let e := Q.ginzburgLayerProjectiveComponentIso k φ x v (-1)
+  have he : e.inv (e.hom y)=y := by
+    change (e.hom ≫ e.inv) y=y
+    rw [e.hom_inv_id]
+    rfl
+  change (Q.unrolledJacobianZAlgebra k φ).ginzburgGeneratorCoefficientComponentEquiv Q v 0
+    (Q.height x) ((Q.ginzburgUpperProjectiveComponentIso k φ x v).hom
+      (Q.ginzburgGeneratorDualToOriginalHomology k φ x.1 v.1 (v.2-x.2)
+        (e.inv (e.hom y))))=_
+  rw [he]
+  exact Q.ginzburgDualOriginalHomology_coefficients k φ x v f
+
+theorem ginzburgDualOriginalProjectiveMap_class
+    (φ : Q.Potential k) (x v : Q.LiftVertex)
+    (f : Q.ginzburgGeneratorFiltrationAtDegree k x.1 v.1 (-1) (-1) (v.2-x.2)) :
+    (Q.unrolledJacobianZAlgebra k φ).ginzburgGeneratorCoefficientComponentEquiv Q v 0
+      (Q.height x) (((Q.unrolledJacobianZAlgebra k φ).rightModuleEvaluation (Q.height x)).map
+        (Q.ginzburgDualOriginalProjectiveMap k φ v)
+          (Q.ginzburgDualCoefficientClass k φ x v f))=
+      Q.ginzburgOriginalDifferentialCoefficients k φ x v f := by
+  rw [Q.ginzburgDualOriginalProjectiveMap_component]
+  exact Q.ginzburgDualOriginalProjectiveComponent_class k φ x v f
+
+end ASGinzburg.CutQuiver
