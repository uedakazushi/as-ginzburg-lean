import work.ASGinzburgDraft.PeriodCutRightVertexDecomposition
import ASGinzburg.PeriodCutRepresentableRightIdealGrading

/-! The actual regular ring is the finite family of zero-sheet graded
representables, respecting the full right action and all integer degrees. -/
namespace ASGinzburg.ZAlgebra.PeriodIso
universe u v
variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k}
variable (Q : CutQuiver) (E : A.PeriodIso (Q.vertices:ℤ))

noncomputable def cutRegularRepresentablesEquiv :
    (∀ i : Q.Vertex,(E.cornerGradedRepresentable Q (i,0)).space) ≃ₗ[k]
      E.CutGradedRing (fun t : Q.Vertex => (t.val:ℤ)) :=
  (LinearEquiv.piCongrRight (fun i => E.cornerRepresentableRightIdealEquiv Q (i,0))).trans
    (E.cutRightVertexDecompositionEquiv Q).symm

theorem cutRegularRepresentablesEquiv_apply
    (f : ∀ i : Q.Vertex,(E.cornerGradedRepresentable Q (i,0)).space) :
    E.cutRegularRepresentablesEquiv Q f=∑ i,E.cornerRepresentableValueMap Q (i,0) (f i) := rfl

theorem cutRegularRepresentablesEquiv_symm_apply
    (r : E.CutGradedRing (fun t : Q.Vertex => (t.val:ℤ))) (i : Q.Vertex) :
    (E.cutRegularRepresentablesEquiv Q).symm r i=E.cornerRepresentableActionMap Q (i,0) r := by
  change E.cornerRepresentableActionMap Q (i,0)
    (E.cutVertexIdempotent (fun t : Q.Vertex => (t.val:ℤ)) i*r)=_
  apply (E.cornerRepresentableRightIdealEquiv Q (i,0)).injective
  apply Subtype.ext
  change E.cornerRepresentableValueMap Q (i,0)
    (E.cornerRepresentableActionMap Q (i,0)
      (E.cutVertexIdempotent (fun t : Q.Vertex => (t.val:ℤ)) i*r))=
    E.cornerRepresentableValueMap Q (i,0) (E.cornerRepresentableActionMap Q (i,0) r)
  rw [E.cornerRepresentableValueMap_actionMap,E.cornerRepresentableValueMap_actionMap,
    ← mul_assoc,E.cutVertexIdempotent_mul_self]

theorem cutRegularRepresentablesEquiv_right_action
    (r : E.CutGradedRing (fun t : Q.Vertex => (t.val:ℤ)))
    (f : ∀ i : Q.Vertex,(E.cornerGradedRepresentable Q (i,0)).space) :
    E.cutRegularRepresentablesEquiv Q
      (fun i => ((E.cornerGradedRepresentable Q (i,0)).representation r).unop (f i))=
        E.cutRegularRepresentablesEquiv Q f*r := by
  rw [E.cutRegularRepresentablesEquiv_apply,E.cutRegularRepresentablesEquiv_apply]
  simp_rw [E.cornerRepresentableValueMap_right_action]
  rw [Finset.sum_mul]

theorem cutRegularRepresentablesEquiv_mem_grade (q : ℤ)
    (f : ∀ i : Q.Vertex,(E.cornerGradedRepresentable Q (i,0)).space)
    (hf : ∀ i,f i∈(E.cornerGradedRepresentable Q (i,0)).grade q) :
    E.cutRegularRepresentablesEquiv Q f∈E.cutIntegerHomogeneousSpace Q q := by
  rw [E.cutRegularRepresentablesEquiv_apply]
  apply Submodule.sum_mem
  intro i hi
  simpa only [add_zero] using E.cornerRepresentableValueMap_mem_grade Q (i,0) q (f i) (hf i)

theorem cutRegularRepresentablesEquiv_symm_mem_grade (q : ℤ)
    (r : E.CutGradedRing (fun t : Q.Vertex => (t.val:ℤ)))
    (hr : r∈E.cutIntegerHomogeneousSpace Q q) (i : Q.Vertex) :
    (E.cutRegularRepresentablesEquiv Q).symm r i∈(E.cornerGradedRepresentable Q (i,0)).grade q := by
  rw [E.cutRegularRepresentablesEquiv_symm_apply]
  apply E.cornerRepresentableActionMap_mem_grade Q (i,0) q r
  simpa only [add_zero] using hr

end ASGinzburg.ZAlgebra.PeriodIso
