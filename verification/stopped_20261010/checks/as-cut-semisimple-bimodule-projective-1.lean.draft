import work.ASGinzburgDraft.ASCutSemisimpleSeparability
import work.ASGinzburgDraft.AlgebraEnvelopingRegularModule

/-! The actual graded-radical quotient of the original AS cut algebra
is projective as its actual regular bimodule over its enveloping algebra. -/
namespace ASGinzburg.ZAlgebra
universe u v
variable {k : Type u} [Field k] (A : ZAlgebra.{u,v} k) (Q : CutQuiver)

theorem ASRegular.cutSemisimpleBimodule_projective (hAS : A.ASRegular Q) :
    letI := regularEnvelopingModule k (hAS.CutGradedAlgebra A Q ⧸ hAS.cutGradedRadical A Q)
    Module.Projective
      (AlgebraEnvelopingRing k (hAS.CutGradedAlgebra A Q ⧸ hAS.cutGradedRadical A Q))
      (hAS.CutGradedAlgebra A Q ⧸ hAS.cutGradedRadical A Q) := by
  letI := regularEnvelopingModule k (hAS.CutGradedAlgebra A Q ⧸ hAS.cutGradedRadical A Q)
  letI := hAS.cutSemisimpleEnveloping_isSemisimple A Q
  exact Module.projective_of_isSemisimpleRing _ _

end ASGinzburg.ZAlgebra
