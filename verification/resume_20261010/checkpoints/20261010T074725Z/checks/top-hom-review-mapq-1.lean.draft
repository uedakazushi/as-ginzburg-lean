import work.ASGinzburgDraft.GradedOrdinaryRingDualHomogeneousTopQuotientType
import Lean
namespace ASGinzburg.GradedOrdinaryModuleData
open CategoryTheory
open scoped ModuleCat.Algebra
universe u v
variable {k : Type u} [Field k] {R : Type v} [Ring R] [Algebra k R]
variable {G : ℤ → Submodule k R}
variable (M L : GradedOrdinaryModuleData k R G)
attribute [local instance 3000] ringDualGradeHasQuotient
set_option maxHeartbeats 20000
set_option diagnostics true
set_option pp.proofs false
set_option pp.explicit false
noncomputable def testMapQ
    (a : M.ringModule ⟶ L.ringModule) (ha : M.PreservesGrade L a) (q : ℤ) :
    M.ringDualHomogeneousTopQuotient L a ha q →ₗ[k] (ordinaryRingDual R M.ringModule ⧸
      LinearMap.range (ordinaryRingDualMapField (k := k) (R := R) a)) := by
  let B := LinearMap.range (ordinaryRingDualMapField (k := k) (R := R) a)
  let C := LinearMap.range (τ₁₂ := RingHom.id k) (M.ringDualMapDegree L a ha q)
  have hk : C ≤ B.comap (M.ringDualGrade q).subtype := by
    rintro f ⟨g,rfl⟩
    exact ⟨g.val,rfl⟩
  let F := C.mapQ B (M.ringDualGrade q).subtype hk
  trace "F created"
  run_tac do
    let goal ← Lean.Elab.Tactic.getMainGoal
    let expected ← goal.getType
    let fExpr ← Lean.Elab.Tactic.elabTerm (← `(F)) none
    let actual ← Lean.Meta.inferType fExpr
    Lean.logInfo m!"Expected head {expected.getAppFn} args {expected.getAppArgs.size}"
    Lean.logInfo m!"Actual head {actual.getAppFn} args {actual.getAppArgs.size}"
    for i in [:expected.getAppArgs.size] do
      Lean.logInfo m!"Expected arg {i}: {expected.getAppArgs[i]!}"
    for i in [:actual.getAppArgs.size] do
      Lean.logInfo m!"Actual arg {i}: {actual.getAppArgs[i]!}"
  exact F
end ASGinzburg.GradedOrdinaryModuleData
