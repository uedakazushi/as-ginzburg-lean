import work.ASGinzburgDraft.GradedOrdinaryRingDualHomogeneousTopQuotientType
import work.ASGinzburgDraft.OrdinaryRingDualCanonicalFieldStructures
import work.ASGinzburgDraft.PeriodCutOrdinaryRingDualShiftedHomNaturality
import work.ASGinzburgDraft.LinearCokernelSquareEquiv

/-! The actual homogeneous ordinary ring-dual top quotient is the
actual shifted regular Hom quotient, via the genuine precomposition square. -/
namespace ASGinzburg.ZAlgebra.PeriodIso
open CategoryTheory
open scoped ModuleCat.Algebra
attribute [local instance 3000] ASGinzburg.GradedOrdinaryModuleData.ringDualGradeHasQuotient
attribute [local instance 4000] ASGinzburg.ordinaryRingDualUnbundledAddCommGroup
universe u v
set_option maxHeartbeats 60000
set_option diagnostics true
set_option synthInstance.maxHeartbeats 100000
variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k}
variable (Q : CutQuiver) (E : A.PeriodIso (Q.vertices : ℤ))
variable {M L : E.CutGradedRightModule Q}

noncomputable abbrev prototypeNativeTopHomAddCommGroup
    (M N : E.CutGradedRightModule Q) : AddCommGroup (M ⟶ N) :=
  inferInstanceAs (AddCommGroup ↥(CutGradedRightModule.homSubmodule M N))

noncomputable abbrev prototypeNativeTopHomFieldModule
    (M N : E.CutGradedRightModule Q) : Module k (M ⟶ N) :=
  inferInstanceAs (Module k ↥(CutGradedRightModule.homSubmodule M N))

attribute [local instance 4000] prototypeNativeTopHomAddCommGroup
attribute [local instance 4000] prototypeNativeTopHomFieldModule

noncomputable def prototypeNativeTopHomQuotientEquiv
    (a : M ⟶ L) (q : ℤ) :
    (E.cutRightModuleOrdinaryData Q M).ringDualHomogeneousTopQuotient
        (E.cutRightModuleOrdinaryData Q L) ((E.cutGradedForgetFunctor Q).map a)
        (E.cutRightModuleOrdinaryMap_preservesGrade Q a) q ≃ₗ[k]
      ((M ⟶ (E.cutRegularGradedRightModule Q).shifted q) ⧸
        LinearMap.range (Linear.leftComp k
          ((E.cutRegularGradedRightModule Q).shifted q) a)) := by
  let DM := E.cutRightModuleOrdinaryData Q M
  let DL := E.cutRightModuleOrdinaryData Q L
  let f : DL.ringDualGrade q →ₗ[k] DM.ringDualGrade q :=
    DM.ringDualMapDegree DL ((E.cutGradedForgetFunctor Q).map a)
    (E.cutRightModuleOrdinaryMap_preservesGrade Q a) q
  let g : (L ⟶ (E.cutRegularGradedRightModule Q).shifted q) →ₗ[k]
      (M ⟶ (E.cutRegularGradedRightModule Q).shifted q) :=
    Linear.leftComp k ((E.cutRegularGradedRightModule Q).shifted q) a
  let eM : DL.ringDualGrade q ≃ₗ[k]
      (L ⟶ (E.cutRegularGradedRightModule Q).shifted q) :=
    E.cutOrdinaryRingDualShiftedHomEquiv Q L q
  trace "source comparison ready"
  let eN : DM.ringDualGrade q ≃ₗ[k]
      (M ⟶ (E.cutRegularGradedRightModule Q).shifted q) :=
    E.cutOrdinaryRingDualShiftedHomEquiv Q M q
  trace "target comparison ready"
  have h : ∀ x, eN (f x) = g (eM x) := by
    intro x
    exact E.cutOrdinaryRingDualShiftedHomEquiv_precomp Q a q x
  trace "square proof ready"
  have dSrc : @Module k (DL.ringDualGrade q) (inferInstanceAs (Semiring k))
      (Submodule.addCommGroup (R := k) (DL.ringDualGrade q)).toAddCommMonoid :=
    Submodule.module (R := k) (DL.ringDualGrade q)
  trace "source Module/group dictionary ready"
  have dDst : @Module k (DM.ringDualGrade q) (inferInstanceAs (Semiring k))
      (Submodule.addCommGroup (R := k) (DM.ringDualGrade q)).toAddCommMonoid :=
    Submodule.module (R := k) (DM.ringDualGrade q)
  trace "target Module/group dictionary ready"
  have dHomSrc : @Module k (L ⟶ (E.cutRegularGradedRightModule Q).shifted q)
      (inferInstanceAs (Semiring k))
      (E.prototypeNativeTopHomAddCommGroup Q L ((E.cutRegularGradedRightModule Q).shifted q)).toAddCommMonoid :=
    E.prototypeNativeTopHomFieldModule Q L ((E.cutRegularGradedRightModule Q).shifted q)
  trace "Hom source Module/group dictionary ready"
  have dHomDst : @Module k (M ⟶ (E.cutRegularGradedRightModule Q).shifted q)
      (inferInstanceAs (Semiring k))
      (E.prototypeNativeTopHomAddCommGroup Q M ((E.cutRegularGradedRightModule Q).shifted q)).toAddCommMonoid :=
    E.prototypeNativeTopHomFieldModule Q M ((E.cutRegularGradedRightModule Q).shifted q)
  trace "Hom target Module/group dictionary ready"
  exact Submodule.Quotient.equiv (LinearMap.range f) (LinearMap.range g) eN
    (linearMapRange_map_eq_of_equiv_square f g eM eN h)

end ASGinzburg.ZAlgebra.PeriodIso
