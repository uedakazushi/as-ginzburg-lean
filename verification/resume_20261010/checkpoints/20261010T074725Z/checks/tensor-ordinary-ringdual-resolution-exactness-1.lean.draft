import ASGinzburg.OrdinaryModuleRingDualDerived
import ASGinzburg.ProjectiveResolutionHomComplex
import ASGinzburg.ModuleCatHomUniverseExt

/-! Actual exactness of a ring-dual resolution complex kills its genuine
derived ring dual, and kills low Abelian Ext against the left regular module.
The latter uses actual categorical cycle and boundary representatives. -/
namespace ASGinzburg
open CategoryTheory CategoryTheory.Limits Opposite
open scoped ModuleCat.Algebra
universe u v
variable (R : Type v) [Ring R]
variable {X : ModuleCat.{v} R} (P : ProjectiveResolution X)

noncomputable def ordinaryRingDualResolutionComplex : CochainComplex (ModuleCat.{v} Rᵐᵒᵖ) ℕ :=
  ((ordinaryRingDualFunctor R).mapHomologicalComplex (ComplexShape.up ℕ)).obj P.complex.op

theorem ordinaryRingDualExt_isZero_of_resolution_exactAt (n : ℕ)
    (he : (ordinaryRingDualResolutionComplex R P).ExactAt n) :
    IsZero ((ordinaryRingDualExtFunctor R n).obj (op X)) := by
  exact IsZero.of_iso he.isZero_homology (ordinaryRingDualResolutionHomologyIso R P n)

variable (k : Type u) [Field k] [Algebra k R]

theorem ordinaryRingDualResolutionComplex_homComplex_exactAt_zero
    (he : (ordinaryRingDualResolutionComplex R P).ExactAt 0) :
    (P.homComplex (k := k) (ModuleCat.of R R)).ExactAt 0 := by
  rw [HomologicalComplex.exactAt_iff' _ 0 0 1 (by simp) (by simp),
    ShortComplex.moduleCat_exact_iff] at he
  apply (P.homComplex_exactAt_zero_iff (k := k) (ModuleCat.of R R)).mpr
  intro f hf
  have hh : ((ordinaryRingDualResolutionComplex R P).d 0 1).hom f.hom = 0 :=
    congrArg ModuleCat.Hom.hom hf
  obtain ⟨g, hg⟩ := he f.hom hh
  have hd : (ordinaryRingDualResolutionComplex R P).d 0 0 = 0 :=
    (ordinaryRingDualResolutionComplex R P).shape 0 0 (by simp)
  change ((ordinaryRingDualResolutionComplex R P).d 0 0).hom g = f.hom at hg
  rw [hd] at hg
  apply ModuleCat.hom_ext
  exact hg.symm

theorem ordinaryRingDualResolutionComplex_homComplex_exactAt_succ (n : ℕ)
    (he : (ordinaryRingDualResolutionComplex R P).ExactAt (n + 1)) :
    (P.homComplex (k := k) (ModuleCat.of R R)).ExactAt (n + 1) := by
  rw [HomologicalComplex.exactAt_iff' _ n (n + 1) (n + 2) (by simp) (by simp),
    ShortComplex.moduleCat_exact_iff] at he
  apply (P.homComplex_exactAt_succ_iff (k := k) (ModuleCat.of R R) n).mpr
  intro f hf
  have hh : ((ordinaryRingDualResolutionComplex R P).d (n + 1) (n + 2)).hom f.hom = 0 :=
    congrArg ModuleCat.Hom.hom hf
  obtain ⟨g, hg⟩ := he f.hom hh
  refine ⟨ModuleCat.ofHom g, ?_⟩
  apply ModuleCat.hom_ext
  exact hg

theorem ordinaryRingDualResolutionComplex_ext_low_eq_zero (n : ℕ) (hn : n < 3)
    (he : (ordinaryRingDualResolutionComplex R P).ExactAt n)
    (e : Abelian.Ext.{v} X (ModuleCat.of R R) n) : e = 0 := by
  apply P.ext_low_eq_zero_of_homComplex_exact (k := k) (ModuleCat.of R R) n hn _ e
  cases n with
  | zero => exact ordinaryRingDualResolutionComplex_homComplex_exactAt_zero R P k he
  | succ n => exact ordinaryRingDualResolutionComplex_homComplex_exactAt_succ R P k n he

end ASGinzburg
