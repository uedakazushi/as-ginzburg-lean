import Mathlib.Algebra.Homology.ShortComplex.ModuleCat
import Mathlib.Algebra.Homology.ShortComplex.HomologicalComplex

/-! Elementwise boundaries in actual chain complexes of modules. -/
namespace ASGinzburg
open CategoryTheory HomologicalComplex
universe u v
variable {k : Type u} [Ring k]

theorem moduleChain_exactAt_iff (K : ChainComplex (ModuleCat.{v} k) ℕ) (n : ℕ) :
    K.ExactAt n ↔ ∀ x : K.X n, K.d n (n - 1) x = 0 →
      ∃ y : K.X (n + 1), K.d (n + 1) n y = x := by
  have hn : (ComplexShape.down ℕ).next n = n - 1 := by
    cases n with
    | zero => exact ChainComplex.next_nat_zero
    | succ n => simp [ChainComplex.next_nat_succ]
  rw [K.exactAt_iff' (i := n + 1) (j := n) (k := n - 1) (by simp) hn]
  exact (K.sc' (n + 1) n (n - 1)).moduleCat_exact_iff

theorem moduleChain_exists_boundary (K : ChainComplex (ModuleCat.{v} k) ℕ)
    (n : ℕ) (h : K.ExactAt n) (x : K.X n) (hx : K.d n (n - 1) x = 0) :
    ∃ y : K.X (n + 1), K.d (n + 1) n y = x :=
  (moduleChain_exactAt_iff K n).mp h x hx

theorem moduleChain_exists_signed_boundary (K : ChainComplex (ModuleCat.{v} k) ℕ)
    (n : ℕ) (h : K.ExactAt n) (x : K.X n) (hx : K.d n (n - 1) x = 0)
    (s : ℤˣ) : ∃ y : K.X (n + 1), (s • K.d (n + 1) n) y = x := by
  obtain ⟨y, hy⟩ := moduleChain_exists_boundary K n h x hx
  refine ⟨s⁻¹ • y, ?_⟩
  change s • (K.d (n + 1) n).hom (s⁻¹ • y) = x
  simp only [Units.smul_def, map_zsmul, smul_smul, ← Int.cast_mul, Units.val_mul,
    mul_inv_cancel, Units.val_one, one_smul, hy]

end ASGinzburg
