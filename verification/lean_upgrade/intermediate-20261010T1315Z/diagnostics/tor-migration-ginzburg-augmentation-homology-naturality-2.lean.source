import ASGinzburg.GinzburgAugmentationLeftAction
import ASGinzburg.GinzburgFiltrationLeftNaturality
import ASGinzburg.GinzburgAugmentationHeightHomology
import ASGinzburg.GinzburgGeneratorFiltrationRadical

/-! Actual augmentation H-zero, its filtration presentation, and the
height comparison are natural for degree-zero left multiplication. -/
namespace ASGinzburg.CutQuiver
open CategoryTheory
universe u
variable (Q : CutQuiver) (k : Type u) [Field k]

set_option backward.isDefEq.respectTransparency false in
theorem ginzburgAugmentationInclusionHomology_left_naturality (φ : Q.Potential k)
    {x y v : Q.LiftVertex} (q : ℤ)
    (f : Q.ginzburgCutCohomologicalComponent k x.1 y.1 0 (y.2-x.2)) :
    Q.ginzburgAugmentationLeftHomology k φ q f ≫
        HomologicalComplex.homologyMap
          (Q.ginzburgAugmentationCochainInclusion k φ x.1 v.1 (v.2-x.2)) q=
      HomologicalComplex.homologyMap
        (Q.ginzburgAugmentationCochainInclusion k φ y.1 v.1 (v.2-y.2)) q ≫
          Q.ginzburgCutLeftHomology k φ q f := by
  have he := congrArg
    ((HomologicalComplex.homologyFunctor (ModuleCat k) (ComplexShape.up ℤ) q).map)
    (Q.ginzburgAugmentationLeftCochainMap_inclusion k φ (v:=v) f)
  simpa only [Functor.map_comp] using he

set_option backward.isDefEq.respectTransparency false in
theorem ginzburgFilteredNegTwoHomologyIso_left_naturality (φ : Q.Potential k)
    {x y v : Q.LiftVertex} (q : ℤ)
    (f : Q.ginzburgCutCohomologicalComponent k x.1 y.1 0 (y.2-x.2)) :
    Q.ginzburgFilteredLeftHomology k φ (-2) q f ≫
        (Q.ginzburgGeneratorFilteredNegTwoHomologyIso k φ x.1 v.1 (v.2-x.2) q).hom=
      (Q.ginzburgGeneratorFilteredNegTwoHomologyIso k φ y.1 v.1 (v.2-y.2) q).hom ≫
        Q.ginzburgAugmentationLeftHomology k φ q f := by
  have he := congrArg
    ((HomologicalComplex.homologyFunctor (ModuleCat k) (ComplexShape.up ℤ) q).map)
    (Q.ginzburgFilteredAugmentationInclusion_left_naturality k φ (v:=v) (-2) f)
  simpa only [Functor.map_comp,ginzburgGeneratorFilteredNegTwoHomologyIso,
    Functor.mapIso_hom,ginzburgGeneratorFilteredNegTwoIso,asIso_hom] using he

theorem ginzburgMiddleAugmentationHomologyIso_left_naturality (φ : Q.Potential k)
    {x y v : Q.LiftVertex}
    (f : Q.ginzburgCutCohomologicalComponent k x.1 y.1 0 (y.2-x.2)) :
    Q.ginzburgFilteredLeftHomology k φ (-1) 0 f ≫
        (Q.ginzburgGeneratorMiddleAugmentationHomologyIso k φ x.1 v.1 (v.2-x.2)).hom=
      (Q.ginzburgGeneratorMiddleAugmentationHomologyIso k φ y.1 v.1 (v.2-y.2)).hom ≫
        Q.ginzburgAugmentationLeftHomology k φ 0 f := by
  have he := Q.ginzburgFilteredInclusionHomology_left_naturality k φ (v:=v) (-2) 0 f
  change Q.ginzburgFilteredLeftHomology k φ (-1) 0 f ≫
      Q.ginzburgGeneratorFilteredInclusionHomology k φ x.1 v.1 (-2) (v.2-x.2) 0=
    Q.ginzburgGeneratorFilteredInclusionHomology k φ y.1 v.1 (-2) (v.2-y.2) 0 ≫
      Q.ginzburgFilteredLeftHomology k φ (-2) 0 f at he
  change Q.ginzburgFilteredLeftHomology k φ (-1) 0 f ≫
      Q.ginzburgGeneratorFilteredInclusionHomology k φ x.1 v.1 (-2) (v.2-x.2) 0 ≫
        (Q.ginzburgGeneratorFilteredNegTwoHomologyIso k φ x.1 v.1 (v.2-x.2) 0).hom=
    (Q.ginzburgGeneratorFilteredInclusionHomology k φ y.1 v.1 (-2) (v.2-y.2) 0 ≫
      (Q.ginzburgGeneratorFilteredNegTwoHomologyIso k φ y.1 v.1 (v.2-y.2) 0).hom) ≫
        Q.ginzburgAugmentationLeftHomology k φ 0 f
  rw [← Category.assoc,he,Category.assoc,
    Q.ginzburgFilteredNegTwoHomologyIso_left_naturality,← Category.assoc]

theorem ginzburgFiltrationRadicalMap_left_naturality (φ : Q.Potential k)
    {x y v : Q.LiftVertex}
    (f : Q.ginzburgCutCohomologicalComponent k x.1 y.1 0 (y.2-x.2)) :
    Q.ginzburgFilteredLeftHomology k φ 0 0 f ≫
        Q.ginzburgGeneratorFiltrationRadicalMap k φ x.1 v.1 (v.2-x.2)=
      Q.ginzburgGeneratorFiltrationRadicalMap k φ y.1 v.1 (v.2-y.2) ≫
        Q.ginzburgAugmentationLeftHomology k φ 0 f := by
  have he := Q.ginzburgFilteredInclusionHomology_left_naturality k φ (v:=v) (-1) 0 f
  change Q.ginzburgFilteredLeftHomology k φ 0 0 f ≫
      Q.ginzburgGeneratorFilteredInclusionHomology k φ x.1 v.1 (-1) (v.2-x.2) 0=
    Q.ginzburgGeneratorFilteredInclusionHomology k φ y.1 v.1 (-1) (v.2-y.2) 0 ≫
      Q.ginzburgFilteredLeftHomology k φ (-1) 0 f at he
  change Q.ginzburgFilteredLeftHomology k φ 0 0 f ≫
      Q.ginzburgGeneratorFilteredInclusionHomology k φ x.1 v.1 (-1) (v.2-x.2) 0 ≫
        (Q.ginzburgGeneratorMiddleAugmentationHomologyIso k φ x.1 v.1 (v.2-x.2)).hom=
    (Q.ginzburgGeneratorFilteredInclusionHomology k φ y.1 v.1 (-1) (v.2-y.2) 0 ≫
      (Q.ginzburgGeneratorMiddleAugmentationHomologyIso k φ y.1 v.1 (v.2-y.2)).hom) ≫
        Q.ginzburgAugmentationLeftHomology k φ 0 f
  rw [← Category.assoc,he,Category.assoc,
    Q.ginzburgMiddleAugmentationHomologyIso_left_naturality,← Category.assoc]

set_option backward.isDefEq.respectTransparency false in
theorem ginzburgAugmentationHeightHomologyIso_left_naturality (φ : Q.Potential k)
    {x y v : Q.LiftVertex} (hx : Q.height x<Q.height v) (hy : Q.height y<Q.height v)
    (q : ℤ) (f : Q.ginzburgCutCohomologicalComponent k x.1 y.1 0 (y.2-x.2)) :
    Q.ginzburgAugmentationLeftHomology k φ q f ≫
        (Q.ginzburgAugmentationHeightHomologyIso k φ x v hx q).hom=
      (Q.ginzburgAugmentationHeightHomologyIso k φ y v hy q).hom ≫
        Q.ginzburgCutLeftHomology k φ q f := by
  simpa only [ginzburgAugmentationHeightHomologyIso,Functor.mapIso_hom,
    ginzburgAugmentationHeightComplexIso,asIso_hom] using
    Q.ginzburgAugmentationInclusionHomology_left_naturality k φ (v:=v) q f

end ASGinzburg.CutQuiver
