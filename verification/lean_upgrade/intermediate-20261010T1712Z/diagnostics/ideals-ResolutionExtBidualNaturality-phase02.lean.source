import ASGinzburg.DualResolutionComparisonMaps
import ASGinzburg.RightResolutionExtBidual
import ASGinzburg.LeftResolutionExtBidual

-- Work-only first-projection phase diagnostic; public source remains unchanged.
-- Frozen public SHA256: cf2b78c08f555570e326421e73061cd89b9de073345b79a810c2f9c1b1c91751
set_option Elab.async false
set_option profiler true
set_option profiler.threshold 50

namespace ASGinzburg.ZAlgebra
open CategoryTheory CategoryTheory.Limits
universe u v
variable {k : Type u} [Field k] (A : ZAlgebra.{u,v} k) {M N : A.RightModule}
  (P : ProjectiveResolution M) (Q : ProjectiveResolution N)
  (hP₄ : IsZero (P.complex.X 4)) (hQ₄ : IsZero (Q.complex.X 4))
  (hP : ∀ n, n<4 → A.rightFiniteProjectiveProperty (P.complex.X n))
  (hQ : ∀ n, n<4 → A.rightFiniteProjectiveProperty (Q.complex.X n))
  (hM : ∀ i n, n<3 → ∀ e : Abelian.Ext.{v} M (A.representable i) n, e=0)
  (hN : ∀ i n, n<3 → ∀ e : Abelian.Ext.{v} N (A.representable i) n, e=0)
  (F : P.complex ⟶ Q.complex)

attribute [local irreducible] rightModuleADual leftModuleADual rightModuleADualMap leftModuleADualMap

#eval IO.println "PHASE BEFORE rightResolutionExtBidualIso_projection"

set_option maxHeartbeats 20000 in
set_option backward.isDefEq.respectTransparency false in
attribute [-instance] leftResolutionExtTopProjectionEpi rightResolutionBidualTopProjectionEpi in
@[reassoc] theorem rightResolutionExtBidualIso_projection :
    A.leftResolutionExtTopProjection (A.rightResolutionDualFourTerm P hP₄ hP hM).toProjectiveResolution
        ((A.rightResolutionDualFourTerm P hP₄ hP hM).complex_isZero_ge_four 0) ≫
      (A.rightResolutionExtBidualIso P hP₄ hP hM).hom =
    A.rightResolutionBidualTopProjection P hP₄ hP hM := by
  let D := A.rightResolutionDualFourTerm P hP₄ hP hM
  let d : A.leftModuleADual (D.complex.X 2) ⟶ A.leftModuleADual (D.complex.X 3) :=
    A.leftModuleADualMap (D.complex.d 3 2)
  let π₁ : A.leftModuleADual (D.complex.X 3) ⟶ A.leftModuleExtRight (A.rightModuleExtLeft M 3) 3 :=
    A.leftResolutionExtTopProjection D.toProjectiveResolution (D.complex_isZero_ge_four 0)
  let π₂ : A.leftModuleADual (D.complex.X 3) ⟶ M :=
    A.rightResolutionBidualTopProjection P hP₄ hP hM
  have z₁ : d ≫ π₁ = 0 :=
    A.leftResolutionExtTopProjection_dual_d₃ D.toProjectiveResolution (D.complex_isZero_ge_four 0)
  have z₂ : d ≫ π₂ = 0 := A.rightResolutionBidualTopProjection_differential P hP₄ hP hM
  haveI : Epi π₁ := A.leftResolutionExtTopProjectionEpi D.toProjectiveResolution (D.complex_isZero_ge_four 0)
  haveI : Epi π₂ := A.rightResolutionBidualTopProjectionEpi P hP₄ hP hM
  let c₁ : CokernelCofork d := CokernelCofork.ofπ π₁ z₁
  let c₂ : CokernelCofork d := CokernelCofork.ofπ π₂ z₂
  have h₁ : IsColimit c₁ :=
    (A.leftResolutionExtTopProjection_exact D.toProjectiveResolution (D.complex_isZero_ge_four 0)).gIsCokernel
  have h₂ : IsColimit c₂ := (A.rightResolutionBidualTopProjection_exact P hP₄ hP hM).gIsCokernel
  run_tac Lean.logInfo "PHASE BEFORE typed comp_coconePointUniqueUpToIso_hom"
  have h : π₁ ≫ (IsColimit.coconePointUniqueUpToIso (C := A.RightModule)
      (F := parallelPair d 0) (s := c₁) (t := c₂) h₁ h₂).hom = π₂ :=
    IsColimit.comp_coconePointUniqueUpToIso_hom (C := A.RightModule)
      (F := parallelPair d 0) (s := c₁) (t := c₂) h₁ h₂ .one
  run_tac Lean.logInfo "PHASE AFTER typed comp_coconePointUniqueUpToIso_hom"
  run_tac Lean.logInfo "PHASE BEFORE selective iso simplification"
  simpa only [rightResolutionExtBidualIso] using h
  run_tac Lean.logInfo "PHASE AFTER selective iso simplification"

#eval IO.println "PHASE AFTER rightResolutionExtBidualIso_projection"

end ASGinzburg.ZAlgebra
