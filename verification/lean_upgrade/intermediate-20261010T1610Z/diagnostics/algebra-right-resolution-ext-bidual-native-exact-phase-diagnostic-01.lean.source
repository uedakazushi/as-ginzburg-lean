import ASGinzburg.RightResolutionDuality
import ASGinzburg.ASLeftExtReciprocity

set_option Elab.async false

namespace ASGinzburg.ZAlgebra
open CategoryTheory CategoryTheory.Limits
universe u v
variable {k : Type u} [Field k] (A : ZAlgebra.{u,v} k)
  {M : A.RightModule} (P : ProjectiveResolution M) (h₄ : IsZero (P.complex.X 4))
  (hP : ∀ n, n<4 → A.rightFiniteProjectiveProperty (P.complex.X n))
  (hExt : ∀ i n, n<3 → ∀ e : Abelian.Ext.{v} M (A.representable i) n, e=0)

attribute [local irreducible] rightModuleADual leftModuleADual rightModuleADualMap leftModuleADualMap

run_cmd Lean.Elab.Command.liftIO <| IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "before term iso"

noncomputable def rightResolutionBidualTermIso (n : ℕ) (hn : n<4) :
    A.leftModuleADual (A.rightModuleADual (P.complex.X n)) ≅ P.complex.X n := by
  letI := A.rightFiniteProjectiveProperty_bidual (hP n hn)
  exact (asIso (A.rightModuleBidualEvaluation (P.complex.X n))).symm

run_cmd Lean.Elab.Command.liftIO <| IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "after term iso"

noncomputable def rightResolutionBidualTopProjection :
    A.leftModuleADual ((A.rightResolutionDualFourTerm P h₄ hP hExt).term 3) ⟶ M :=
  (A.rightResolutionBidualTermIso P hP 0 (by decide)).hom ≫ P.π.f 0

run_cmd Lean.Elab.Command.liftIO <| IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "after top projection"

set_option backward.isDefEq.respectTransparency false in
attribute [-instance] leftResolutionExtTopProjectionEpi in
noncomputable instance rightResolutionBidualTopProjectionEpi :
    Epi (A.rightResolutionBidualTopProjection P h₄ hP hExt) := by
  letI := A.rightFiniteProjectiveProperty_bidual (hP 0 (by decide))
  letI : Epi (A.rightResolutionBidualTermIso P hP 0 (by decide)).hom := inferInstance
  letI : Epi (P.π.f 0) := inferInstance
  dsimp only [rightResolutionBidualTopProjection]
  infer_instance

run_cmd Lean.Elab.Command.liftIO <| IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "after projection Epi"

set_option backward.isDefEq.respectTransparency false in
theorem rightResolutionBidualTopDifferential_comm :
    A.leftModuleADualMap ((A.rightResolutionDualFourTerm P h₄ hP hExt).complex.d 3 2) ≫
      (A.rightResolutionBidualTermIso P hP 0 (by decide)).hom =
    (A.rightResolutionBidualTermIso P hP 1 (by decide)).hom ≫ P.complex.d 1 0 := by
  letI := A.rightFiniteProjectiveProperty_bidual (hP 0 (by decide))
  letI := A.rightFiniteProjectiveProperty_bidual (hP 1 (by decide))
  rw [show (A.rightResolutionDualFourTerm P h₄ hP hExt).complex.d 3 2 =
    A.rightModuleADualMap (P.complex.d 1 0) from ChainComplex.of_d
      (A.rightResolutionDualFourTerm P h₄ hP hExt).term
      (A.rightResolutionDualFourTerm P h₄ hP hExt).differential 2]
  change A.leftModuleADualMap (A.rightModuleADualMap (P.complex.d 1 0)) ≫
    inv (A.rightModuleBidualEvaluation (P.complex.X 0)) =
    inv (A.rightModuleBidualEvaluation (P.complex.X 1)) ≫ P.complex.d 1 0
  have H := A.rightModuleBidualEvaluation_natural (P.complex.d 1 0)
  apply Eq.symm
  rw [IsIso.inv_comp_eq,← Category.assoc,← H]
  simp only [Category.assoc,IsIso.hom_inv_id,Category.comp_id]

run_cmd Lean.Elab.Command.liftIO <| IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "after differential comm"

set_option backward.isDefEq.respectTransparency false in
theorem rightResolutionBidualTopProjection_differential :
    A.leftModuleADualMap ((A.rightResolutionDualFourTerm P h₄ hP hExt).complex.d 3 2) ≫
      A.rightResolutionBidualTopProjection P h₄ hP hExt = 0 := by
  dsimp only [rightResolutionBidualTopProjection]
  rw [← Category.assoc,A.rightResolutionBidualTopDifferential_comm,
    Category.assoc,P.complex_d_comp_π_f_zero,comp_zero]

run_cmd Lean.Elab.Command.liftIO <| IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "after projection differential"

set_option maxHeartbeats 20000 in
set_option backward.isDefEq.respectTransparency false in
theorem rightResolutionBidualTopProjection_exact :
    (ShortComplex.mk
      (A.leftModuleADualMap ((A.rightResolutionDualFourTerm P h₄ hP hExt).complex.d 3 2))
      (A.rightResolutionBidualTopProjection P h₄ hP hExt)
      (A.rightResolutionBidualTopProjection_differential P h₄ hP hExt)).Exact := by
  letI := A.rightFiniteProjectiveProperty_bidual (hP 0 (by decide))
  letI := A.rightFiniteProjectiveProperty_bidual (hP 1 (by decide))
  run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "exact: after bidual IsIso witnesses"))
  have hd : (A.rightResolutionDualFourTerm P h₄ hP hExt).complex.d 3 2 =
      A.rightModuleADualMap (P.complex.d 1 0) :=
    ChainComplex.of_d (A.rightResolutionDualFourTerm P h₄ hP hExt).term
      (A.rightResolutionDualFourTerm P h₄ hP hExt).differential 2
  run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "exact: after native differential equality"))
  have hz : A.leftModuleADualMap (A.rightModuleADualMap (P.complex.d 1 0)) ≫
      ((A.rightResolutionBidualTermIso P hP 0 (by decide)).hom ≫ P.π.f 0) = 0 := by
    simpa only [hd, rightResolutionBidualTopProjection] using
      (A.rightResolutionBidualTopProjection_differential P h₄ hP hExt)
  run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "exact: after native zero equation"))
  let S : ShortComplex A.RightModule := ShortComplex.mk
    (A.leftModuleADualMap (A.rightModuleADualMap (P.complex.d 1 0)))
    ((A.rightResolutionBidualTermIso P hP 0 (by decide)).hom ≫ P.π.f 0) hz
  run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "exact: after native short complex goal"))
  let T := ShortComplex.mk (P.complex.d 1 0) (P.π.f 0) P.complex_d_comp_π_f_zero
  let e : S ≅ T :=
    ShortComplex.isoMk (S₁ := S) (S₂ := T) (A.rightResolutionBidualTermIso P hP 1 (by decide))
      (A.rightResolutionBidualTermIso P hP 0 (by decide)) (Iso.refl M)
      (by
        change (A.rightResolutionBidualTermIso P hP 1 (by decide)).hom ≫ P.complex.d 1 0 =
          A.leftModuleADualMap (A.rightModuleADualMap (P.complex.d 1 0)) ≫
            (A.rightResolutionBidualTermIso P hP 0 (by decide)).hom
        have hc := A.rightResolutionBidualTopDifferential_comm P h₄ hP hExt
        rw [hd] at hc
        exact hc.symm)
      (by
        change ((A.rightResolutionBidualTermIso P hP 0 (by decide)).hom ≫ P.π.f 0) ≫ (𝟙 M) =
          (A.rightResolutionBidualTermIso P hP 0 (by decide)).hom ≫ P.π.f 0
        exact Category.comp_id _)
  run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "exact: after native short complex iso"))
  simpa only [hd, rightResolutionBidualTopProjection, S] using
    ((ShortComplex.exact_iff_of_iso e).mpr P.exact₀)
  run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "exact: after exactness proof"))
run_cmd Lean.Elab.Command.liftIO <| IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-native-exact-phase-diagnostic-01.marker.txt" "after exactness declaration"
end ASGinzburg.ZAlgebra
