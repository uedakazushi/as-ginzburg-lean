import RightResolutionExtBidualPrefix

set_option Elab.async false

namespace ASGinzburg.ZAlgebra
open CategoryTheory CategoryTheory.Limits
universe u v
variable {k : Type u} [Field k] (A : ZAlgebra.{u,v} k)
  {M : A.RightModule} (P : ProjectiveResolution M) (h₄ : IsZero (P.complex.X 4))
  (hP : ∀ n, n<4 → A.rightFiniteProjectiveProperty (P.complex.X n))
  (hExt : ∀ i n, n<3 → ∀ e : Abelian.Ext.{v} M (A.representable i) n, e=0)

attribute [local irreducible] rightModuleADual leftModuleADual rightModuleADualMap leftModuleADualMap

set_option backward.isDefEq.respectTransparency false in
theorem rightResolutionBidualTopProjection_exact :
    (ShortComplex.mk
      (A.leftModuleADualMap ((A.rightResolutionDualFourTerm P h₄ hP hExt).complex.d 3 2))
      (A.rightResolutionBidualTopProjection P h₄ hP hExt)
      (A.rightResolutionBidualTopProjection_differential P h₄ hP hExt)).Exact := by
  letI := A.rightFiniteProjectiveProperty_bidual (hP 0 (by decide))
  letI := A.rightFiniteProjectiveProperty_bidual (hP 1 (by decide))
  let T := ShortComplex.mk (P.complex.d 1 0) (P.π.f 0) P.complex_d_comp_π_f_zero
  run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-cached-projective-equality-diagnostic-01.marker.txt" "exact: before original iso"))
  let e : ShortComplex.mk
      (A.leftModuleADualMap ((A.rightResolutionDualFourTerm P h₄ hP hExt).complex.d 3 2))
      (A.rightResolutionBidualTopProjection P h₄ hP hExt)
      (A.rightResolutionBidualTopProjection_differential P h₄ hP hExt) ≅ T :=
    ShortComplex.isoMk (A.rightResolutionBidualTermIso P hP 1 (by decide))
      (A.rightResolutionBidualTermIso P hP 0 (by decide)) (Iso.refl _)
      (by exact (A.rightResolutionBidualTopDifferential_comm P h₄ hP hExt).symm)
      (by
        dsimp only [T, rightResolutionBidualTopProjection, Iso.refl]
        exact (Category.comp_id _).symm)
  run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-cached-projective-equality-diagnostic-01.marker.txt" "exact: after original iso"))
  exact (ShortComplex.exact_iff_of_iso e).mpr P.exact₀
  run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-cached-projective-equality-diagnostic-01.marker.txt" "exact: after exactness proof"))

run_cmd Lean.Elab.Command.liftIO <| IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-cached-projective-equality-diagnostic-01.marker.txt" "after exactness declaration"
set_option backward.isDefEq.respectTransparency false in
attribute [-instance] leftResolutionExtTopProjectionEpi in
/-- Actual degree-three Ext twice recovers M by the canonical finite-projective evaluation. -/
noncomputable def rightResolutionExtBidualIso :
    A.leftModuleExtRight (A.rightModuleExtLeft M 3) 3 ≅ M := by
  let make (D : ProjectiveResolution (A.rightModuleExtLeft M 3))
      (hD : D = (A.rightResolutionDualFourTerm P h₄ hP hExt).toProjectiveResolution) :
      A.leftModuleExtRight (A.rightModuleExtLeft M 3) 3 ≅ M := by
    have hD₄ : IsZero (D.complex.X 4) := by
      cases hD
      exact (A.rightResolutionDualFourTerm P h₄ hP hExt).complex_isZero_ge_four 0
    let f : A.leftModuleADual (D.complex.X 2) ⟶ A.leftModuleADual (D.complex.X 3) :=
      A.leftModuleADualMap (D.complex.d 3 2)
    let π₂ : A.leftModuleADual (D.complex.X 3) ⟶ M :=
      hD.symm ▸ A.rightResolutionBidualTopProjection P h₄ hP hExt
    have hπ₂ : f ≫ π₂ = 0 := by
      cases hD
      exact A.rightResolutionBidualTopProjection_differential P h₄ hP hExt
    haveI : Epi π₂ := by
      cases hD
      exact A.rightResolutionBidualTopProjectionEpi P h₄ hP hExt
    run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-cached-projective-equality-diagnostic-01.marker.txt" "make: after original bidual Epi"))
    have h₂ : IsColimit (CokernelCofork.ofπ (f := f) π₂ hπ₂) := by
      cases hD
      exact (A.rightResolutionBidualTopProjection_exact P h₄ hP hExt).gIsCokernel
    run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-cached-projective-equality-diagnostic-01.marker.txt" "make: after original bidual cokernel"))
    haveI : Epi (A.leftResolutionExtTopProjection D hD₄) :=
      A.leftResolutionExtTopProjectionEpi D hD₄
    have h₁ : IsColimit (CokernelCofork.ofπ (f := f)
        (A.leftResolutionExtTopProjection D hD₄)
        (A.leftResolutionExtTopProjection_dual_d₃ D hD₄)) :=
      (A.leftResolutionExtTopProjection_exact D hD₄).gIsCokernel
    run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-cached-projective-equality-diagnostic-01.marker.txt" "make: after original Ext cokernel"))
    exact IsColimit.coconePointUniqueUpToIso (F := parallelPair f 0) h₁ h₂
    run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-cached-projective-equality-diagnostic-01.marker.txt" "make: after original exact iso"))
  exact make (A.rightResolutionDualFourTerm P h₄ hP hExt).toProjectiveResolution rfl
  run_tac liftM (Lean.Core.liftIOCore (IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-cached-projective-equality-diagnostic-01.marker.txt" "after original resolution and rfl"))
run_cmd Lean.Elab.Command.liftIO <| IO.FS.writeFile "work/lean-upgrade/algebra-right-resolution-ext-bidual-cached-projective-equality-diagnostic-01.marker.txt" "after final iso declaration"
end ASGinzburg.ZAlgebra
