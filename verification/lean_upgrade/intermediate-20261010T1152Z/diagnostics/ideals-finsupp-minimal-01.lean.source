import Mathlib.LinearAlgebra.Finsupp.Supported
import Mathlib.LinearAlgebra.Isomorphisms
universe u v
variable (k : Type u) [Field k] (α : Type v) (s t : Set α)
set_option backward.isDefEq.respectTransparency false in
#check (Finsupp.supported k k t ⧸ (Finsupp.supported k k s).comap (Finsupp.supported k k t).subtype)
#check (by
  letI : AddCommGroup (α →₀ k) := Finsupp.instAddCommGroup
  exact (Finsupp.supported k k t ⧸ (Finsupp.supported k k s).comap (Finsupp.supported k k t).subtype) : Type (max u v))
set_option pp.all true in
#check @Finsupp.instAddCommGroup
