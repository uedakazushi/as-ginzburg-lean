import ASGinzburg.ASResolution
import ASGinzburg.RightModuleExt

/-!
# From the finite minimal AS sequence to a mathlib projective resolution

The input is the concrete sequence in Definition 1.1(i). We prove positive
degree exactness and that its augmentation to s_v is a quasi-isomorphism.
No existence of the input sequence for an arbitrary algebra is claimed.
-/

namespace ASGinzburg.ZAlgebra.ASResolution
open CategoryTheory CategoryTheory.Limits
open scoped ZeroObject
universe u v
variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k} {Q : CutQuiver}
variable {v : Q.LiftVertex} (R : A.ASResolution Q v)

/-- Extend the four actual projective terms by zero in degrees ≥4. -/
noncomputable def complexTerm (_R : A.ASResolution Q v) : ℕ → A.RightModule
  | 0 => A.representable (Q.height v)
  | 1 => A.asResolutionTerm₁ Q v
  | 2 => A.asResolutionTerm₂ Q v
  | 3 => A.representable (Q.height (Q.tau.symm v))
  | _ + 4 => 0

noncomputable def complexDifferential : ∀ n : ℕ, R.complexTerm (n + 1) ⟶ R.complexTerm n
  | 0 => R.d₁
  | 1 => R.d₂
  | 2 => R.d₃
  | _ + 3 => 0

theorem complexDifferential_sq (n : ℕ) :
    R.complexDifferential (n + 1) ≫ R.complexDifferential n = 0 := by
  rcases n with _ | _ | _ | n
  · exact R.d₂_d₁
  · exact R.d₃_d₂
  · exact zero_comp
  · simp [complexDifferential]

/-- A genuine mathlib chain complex, retaining the finite AS terms and differentials. -/
noncomputable def complex : ChainComplex A.RightModule ℕ :=
  ChainComplex.of R.complexTerm R.complexDifferential R.complexDifferential_sq

noncomputable instance complexTermProjective (n : ℕ) : Projective (R.complexTerm n) := by
  rcases n with _ | _ | _ | _ | n <;> dsimp [complexTerm] <;> infer_instance

set_option backward.isDefEq.respectTransparency false in
theorem complex_exactAt_succ (n : ℕ) : R.complex.ExactAt (n + 1) := by
  rw [HomologicalComplex.exactAt_iff' _ (n + 2) (n + 1) n (by simp) (by simp)]
  rcases n with _ | _ | _ | n
  · change (ShortComplex.mk (R.complex.d 2 1) (R.complex.d 1 0) _).Exact
    simpa only [show R.complex.d 2 1 = R.d₂ from ChainComplex.of_d R.complexTerm R.complexDifferential 1,
      show R.complex.d 1 0 = R.d₁ from ChainComplex.of_d R.complexTerm R.complexDifferential 0] using R.exact₁
  · change (ShortComplex.mk (R.complex.d 3 2) (R.complex.d 2 1) _).Exact
    simpa only [show R.complex.d 3 2 = R.d₃ from ChainComplex.of_d R.complexTerm R.complexDifferential 2,
      show R.complex.d 2 1 = R.d₂ from ChainComplex.of_d R.complexTerm R.complexDifferential 1] using R.exact₂
  · letI : Mono R.d₃ := R.mono_d₃
    apply (ShortComplex.exact_iff_mono _ ?_).mpr
    · change Mono (R.complex.d 3 2)
      rw [show R.complex.d 3 2 = R.d₃ from ChainComplex.of_d R.complexTerm R.complexDifferential 2]
      infer_instance
    · change R.complex.d 4 3 = 0
      exact ChainComplex.of_d R.complexTerm R.complexDifferential 3
  · apply ShortComplex.exact_of_isZero_X₂
    change IsZero (R.complexTerm (n+4))
    exact isZero_zero A.RightModule

noncomputable def augmentation : R.complex ⟶
    (ChainComplex.single₀ A.RightModule).obj (A.simpleRightModule (Q.height v)) :=
  (ChainComplex.toSingle₀Equiv _ _).symm ⟨A.simpleRightModuleπ (Q.height v), by
    rw [show R.complex.d 1 0 = R.d₁ from ChainComplex.of_d R.complexTerm R.complexDifferential 0]
    exact R.d₁_π⟩

set_option backward.isDefEq.respectTransparency false in
noncomputable instance augmentationQuasiIso : QuasiIso R.augmentation := ⟨fun n => by
  cases n
  · rw [ChainComplex.quasiIsoAt₀_iff, ShortComplex.quasiIso_iff_of_zeros']
    · refine (ShortComplex.exact_and_epi_g_iff_of_iso ?_).2
        ⟨R.exact₀, by infer_instance⟩
      exact ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _)
        (by
          change (𝟙 (A.asResolutionTerm₁ Q v)) ≫ R.d₁ =
            R.complex.d 1 0 ≫ (𝟙 (A.representable (Q.height v)))
          calc
            (𝟙 (A.asResolutionTerm₁ Q v)) ≫ R.d₁ = R.d₁ := Category.id_comp _
            _ = R.complex.d 1 0 := (ChainComplex.of_d R.complexTerm R.complexDifferential 0).symm
            _ = R.complex.d 1 0 ≫ (𝟙 (A.representable (Q.height v))) := (Category.comp_id _).symm)
        (by
          change (𝟙 (A.representable (Q.height v))) ≫ A.simpleRightModuleπ (Q.height v) =
            R.augmentation.f 0 ≫ (𝟙 (A.simpleRightModule (Q.height v)))
          calc
            (𝟙 (A.representable (Q.height v))) ≫ A.simpleRightModuleπ (Q.height v) =
                A.simpleRightModuleπ (Q.height v) := Category.id_comp _
            _ = R.augmentation.f 0 :=
              (ChainComplex.toSingle₀Equiv_symm_apply_f_zero (A.simpleRightModuleπ (Q.height v)) (by
                rw [show R.complex.d 1 0 = R.d₁ from
                  ChainComplex.of_d R.complexTerm R.complexDifferential 0]
                exact R.d₁_π)).symm
            _ = R.augmentation.f 0 ≫ (𝟙 (A.simpleRightModule (Q.height v))) := (Category.comp_id _).symm)
    all_goals rfl
  · rw [quasiIsoAt_iff_exactAt']
    · apply R.complex_exactAt_succ
    · apply ChainComplex.exactAt_succ_single_obj⟩

/-- The supplied finite AS sequence is a genuine mathlib projective resolution of s_v. -/
noncomputable def toProjectiveResolution : ProjectiveResolution (A.simpleRightModule (Q.height v)) where
  complex := R.complex
  projective n := by change Projective (R.complexTerm n); infer_instance
  π := R.augmentation
  quasiIso := R.augmentationQuasiIso

theorem complex_isZero_ge_four (n : ℕ) : IsZero (R.complex.X (n + 4)) := by
  change IsZero (R.complexTerm (n + 4))
  exact isZero_zero A.RightModule

end ASGinzburg.ZAlgebra.ASResolution
