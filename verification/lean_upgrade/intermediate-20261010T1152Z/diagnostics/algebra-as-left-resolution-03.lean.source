import ASGinzburg.ASFiniteProjectiveComplex
import ASGinzburg.ASDualityComplexExactness
import ASGinzburg.ASDualityTopCokernel
import ASGinzburg.ASDualityLeftComponents
import ASGinzburg.LeftModuleExt

namespace ASGinzburg.ZAlgebra.ASResolution
open CategoryTheory CategoryTheory.Limits Opposite
open scoped ZeroObject
universe u v
variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k} {Q : CutQuiver}
  {w : Q.LiftVertex} (R : A.ASResolution Q w)

theorem dualComplex_d (n : ℕ) :
    R.dualComplex.d n (n+1) = A.rightModuleADualMap (R.complexDifferential n) := by
  change A.rightModuleADualMap (R.complex.d (n+1) n) = _
  rw [show R.complex.d (n+1) n = R.complexDifferential n from
    ChainComplex.of_d R.complexTerm R.complexDifferential n]
  rfl

noncomputable def leftResolutionTerm : ℕ → A.LeftModule
  | 0 => A.rightModuleADual (R.complexTerm 3)
  | 1 => A.rightModuleADual (R.complexTerm 2)
  | 2 => A.rightModuleADual (R.complexTerm 1)
  | 3 => A.rightModuleADual (R.complexTerm 0)
  | _+4 => 0

noncomputable def leftResolutionDifferential : ∀ n, R.leftResolutionTerm (n+1) ⟶ R.leftResolutionTerm n
  | 0 => A.rightModuleADualMap R.d₃
  | 1 => A.rightModuleADualMap R.d₂
  | 2 => A.rightModuleADualMap R.d₁
  | _+3 => 0

theorem leftResolutionDifferential_sq (n : ℕ) :
    R.leftResolutionDifferential (n+1) ≫ R.leftResolutionDifferential n = 0 := by
  rcases n with _ | _ | _ | n
  · change A.rightModuleADualFunctor.map R.d₂.op ≫ A.rightModuleADualFunctor.map R.d₃.op = 0
    rw [← A.rightModuleADualFunctor.map_comp, ← op_comp, R.d₃_d₂]
    exact A.rightModuleADualFunctor.map_zero _ _
  · change A.rightModuleADualFunctor.map R.d₁.op ≫ A.rightModuleADualFunctor.map R.d₂.op = 0
    rw [← A.rightModuleADualFunctor.map_comp, ← op_comp, R.d₂_d₁]
    exact A.rightModuleADualFunctor.map_zero _ _
  · exact zero_comp
  · simp [leftResolutionDifferential]

noncomputable def leftResolutionComplex : ChainComplex A.LeftModule ℕ :=
  ChainComplex.of R.leftResolutionTerm R.leftResolutionDifferential R.leftResolutionDifferential_sq

noncomputable instance leftResolutionTermProjective (n : ℕ) : Projective (R.leftResolutionTerm n) := by
  rcases n with _ | _ | _ | _ | n
  · exact A.leftFiniteProjectiveProperty_projective
      (A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 3))
  · exact A.leftFiniteProjectiveProperty_projective
      (A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 2))
  · exact A.leftFiniteProjectiveProperty_projective
      (A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 1))
  · exact A.leftFiniteProjectiveProperty_projective
      (A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 0))
  · dsimp [leftResolutionTerm]; infer_instance
end ASGinzburg.ZAlgebra.ASResolution

namespace ASGinzburg.ZAlgebra.ASResolution
open CategoryTheory CategoryTheory.Limits
universe u v
variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k} {Q : CutQuiver}
  {w : Q.LiftVertex} (R : A.ASResolution Q w)

theorem dual_d₁_mono (h : A.ASRegular Q) : Mono (A.rightModuleADualMap R.d₁) := by
  have he := R.dualComplex_exactAt_low h 0 (by decide)
  rw [HomologicalComplex.exactAt_iff' _ 0 0 1 (by simp) (by simp)] at he
  have hf : (R.dualComplex.sc' 0 0 1).f = 0 := R.dualComplex.shape 0 0 (by simp)
  have hm : Mono (R.dualComplex.d 0 1) := (ShortComplex.exact_iff_mono _ hf).mp he
  rw [R.dualComplex_d 0] at hm
  exact hm

set_option backward.isDefEq.respectTransparency false in
theorem leftResolutionComplex_exactAt_succ (h : A.ASRegular Q) (n : ℕ) :
    R.leftResolutionComplex.ExactAt (n+1) := by
  rw [HomologicalComplex.exactAt_iff' _ (n+2) (n+1) n (by simp) (by simp)]
  rcases n with _ | _ | _ | n
  · have he := R.dualComplex_exactAt_low h 2 (by decide)
    rw [HomologicalComplex.exactAt_iff' _ 1 2 3 (by simp) (by simp)] at he
    change (ShortComplex.mk (R.dualComplex.d 1 2) (R.dualComplex.d 2 3) _).Exact at he
    simp only [R.dualComplex_d 1, R.dualComplex_d 2] at he
    change (ShortComplex.mk (R.leftResolutionComplex.d 2 1)
      (R.leftResolutionComplex.d 1 0) _).Exact
    simpa only [show R.leftResolutionComplex.d 2 1 = A.rightModuleADualMap R.d₂ from
      ChainComplex.of_d R.leftResolutionTerm R.leftResolutionDifferential 1,
      show R.leftResolutionComplex.d 1 0 = A.rightModuleADualMap R.d₃ from
        ChainComplex.of_d R.leftResolutionTerm R.leftResolutionDifferential 0] using he
  · have he := R.dualComplex_exactAt_low h 1 (by decide)
    rw [HomologicalComplex.exactAt_iff' _ 0 1 2 (by simp) (by simp)] at he
    change (ShortComplex.mk (R.dualComplex.d 0 1) (R.dualComplex.d 1 2) _).Exact at he
    simp only [R.dualComplex_d 0, R.dualComplex_d 1] at he
    change (ShortComplex.mk (R.leftResolutionComplex.d 3 2)
      (R.leftResolutionComplex.d 2 1) _).Exact
    simpa only [show R.leftResolutionComplex.d 3 2 = A.rightModuleADualMap R.d₁ from
      ChainComplex.of_d R.leftResolutionTerm R.leftResolutionDifferential 2,
      show R.leftResolutionComplex.d 2 1 = A.rightModuleADualMap R.d₂ from
        ChainComplex.of_d R.leftResolutionTerm R.leftResolutionDifferential 1] using he
  · letI := R.dual_d₁_mono h
    apply (ShortComplex.exact_iff_mono _ ?_).mpr
    · change Mono (R.leftResolutionComplex.d 3 2)
      rw [show R.leftResolutionComplex.d 3 2 = A.rightModuleADualMap R.d₁ from
        ChainComplex.of_d R.leftResolutionTerm R.leftResolutionDifferential 2]
      infer_instance
    · change R.leftResolutionComplex.d 4 3 = 0
      exact ChainComplex.of_d R.leftResolutionTerm R.leftResolutionDifferential 3
  · apply ShortComplex.exact_of_isZero_X₂
    change IsZero (R.leftResolutionTerm (n+4))
    exact isZero_zero A.LeftModule
end ASGinzburg.ZAlgebra.ASResolution

namespace ASGinzburg.ZAlgebra.ASResolution
open CategoryTheory CategoryTheory.Limits
universe u v
variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k} {Q : CutQuiver}
  {w : Q.LiftVertex} (R : A.ASResolution Q w) (h : A.ASRegular Q)

noncomputable def leftResolutionProjection : R.leftResolutionTerm 0 ⟶
    A.simpleLeftModule (Q.height (Q.tau.symm w)) :=
  R.dualTopProjection ≫ (h.extLeftThreeIsoSimple A Q w).hom

set_option backward.isDefEq.respectTransparency false in
noncomputable instance leftResolutionProjectionEpi : Epi (R.leftResolutionProjection h) := by
  dsimp [leftResolutionProjection]
  infer_instance

set_option backward.isDefEq.respectTransparency false in
theorem leftResolutionProjection_differential :
    R.leftResolutionDifferential 0 ≫ R.leftResolutionProjection h = 0 := by
  change A.rightModuleADualMap R.d₃ ≫ (R.dualTopProjection ≫ _) = 0
  rw [← Category.assoc, R.dualTopProjection_dual_d₃, zero_comp]

set_option backward.isDefEq.respectTransparency false in
theorem leftResolutionProjection_exact :
    (ShortComplex.mk (R.leftResolutionDifferential 0) (R.leftResolutionProjection h)
      (R.leftResolutionProjection_differential h)).Exact := by
  let e := h.extLeftThreeIsoSimple A Q w
  let T := ShortComplex.mk (A.rightModuleADualMap R.d₃) R.dualTopProjection R.dualTopProjection_dual_d₃
  let eS : ShortComplex.mk (R.leftResolutionDifferential 0) (R.leftResolutionProjection h)
      (R.leftResolutionProjection_differential h) ≅ T :=
    ShortComplex.isoMk (Iso.refl _) (Iso.refl _) e.symm
      (by simp [T,leftResolutionDifferential])
      (by simp [T,leftResolutionProjection,e,Category.assoc])
  exact (ShortComplex.exact_iff_of_iso eS).mpr R.dualTopProjection_exact

set_option backward.isDefEq.respectTransparency false in
noncomputable def leftResolutionAugmentation : R.leftResolutionComplex ⟶
    (ChainComplex.single₀ A.LeftModule).obj (A.simpleLeftModule (Q.height (Q.tau.symm w))) :=
  (ChainComplex.toSingle₀Equiv _ _).symm ⟨R.leftResolutionProjection h, by
    rw [show R.leftResolutionComplex.d 1 0 = R.leftResolutionDifferential 0 from
      ChainComplex.of_d R.leftResolutionTerm R.leftResolutionDifferential 0]
    exact R.leftResolutionProjection_differential h⟩

set_option backward.isDefEq.respectTransparency false in
noncomputable instance leftResolutionAugmentationQuasiIso : QuasiIso (R.leftResolutionAugmentation h) := ⟨fun n => by
  cases n
  · rw [ChainComplex.quasiIsoAt₀_iff, ShortComplex.quasiIso_iff_of_zeros']
    · refine (ShortComplex.exact_and_epi_g_iff_of_iso ?_).2
        ⟨R.leftResolutionProjection_exact h, by infer_instance⟩
      exact ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _)
        (by dsimp; exact (ChainComplex.of_d R.leftResolutionTerm R.leftResolutionDifferential
          0).symm) (by simp [leftResolutionAugmentation])
    all_goals rfl
  · rw [quasiIsoAt_iff_exactAt']
    · exact R.leftResolutionComplex_exactAt_succ h _
    · exact ChainComplex.exactAt_succ_single_obj _ _⟩

noncomputable def toLeftProjectiveResolution :
    ProjectiveResolution (A.simpleLeftModule (Q.height (Q.tau.symm w))) where
  complex := R.leftResolutionComplex
  projective n := by change Projective (R.leftResolutionTerm n); infer_instance
  π := R.leftResolutionAugmentation h
  quasiIso := R.leftResolutionAugmentationQuasiIso h
end ASGinzburg.ZAlgebra.ASResolution

namespace ASGinzburg.ZAlgebra.ASResolution
open CategoryTheory CategoryTheory.Limits
open scoped ZeroObject
universe u v
variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k} {Q : CutQuiver}
  {w : Q.LiftVertex} (R : A.ASResolution Q w)

theorem leftResolutionTermFiniteProjective (n : ℕ) :
    A.leftFiniteProjectiveProperty (R.leftResolutionTerm n) := by
  rcases n with _ | _ | _ | _ | n
  · exact A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 3)
  · exact A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 2)
  · exact A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 1)
  · exact A.rightFiniteProjectiveProperty_dual (R.complexTermFiniteProjective 0)
  · exact A.leftFiniteProjectiveProperty_of_isZero (isZero_zero A.LeftModule)

theorem leftResolutionComplex_isZero_ge_four (n : ℕ) :
    IsZero (R.leftResolutionComplex.X (n+4)) := by
  change IsZero (R.leftResolutionTerm (n+4))
  exact isZero_zero A.LeftModule
end ASGinzburg.ZAlgebra.ASResolution

namespace ASGinzburg.ZAlgebra.ASRegular
open CategoryTheory
universe u v
variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k} {Q : CutQuiver}

noncomputable def leftSimpleProjectiveResolution (h : A.ASRegular Q) (u : Q.LiftVertex) :
    ProjectiveResolution (A.simpleLeftModule (Q.height u)) := by
  simpa only [Equiv.symm_apply_apply] using (h.resolution A Q (Q.tau u)).toLeftProjectiveResolution h
end ASGinzburg.ZAlgebra.ASRegular
