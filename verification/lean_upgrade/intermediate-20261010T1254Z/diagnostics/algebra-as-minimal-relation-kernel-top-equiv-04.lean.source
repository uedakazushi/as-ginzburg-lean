import ASGinzburg.ASMinimalRelationDenominator

/-! The genuine original minimal relation space I/(IJ+JI) is the
actual AS first-kernel radical quotient. All denominators and maps are
proved from the existing resolution, rather than assumed Ext data. -/
namespace ASGinzburg.ZAlgebra
open CategoryTheory CategoryTheory.Limits
universe u v
variable {k : Type u} [Field k] (A : ZAlgebra.{u,v} k) (Q : CutQuiver)
  (R : ∀ w : Q.LiftVertex, A.ASResolution Q w)

noncomputable def pathRelationsToASFirstKernelTop (u w : Q.LiftVertex) (huw : u≠w) :
    LinearMap.ker (A.unrolledPathLinearEvaluation Q R u w) →ₗ[k]
      ((A.rightModuleEvaluation (Q.height u)).obj (kernel (R w).d₁) ⧸
        A.positiveActionSpan (kernel (R w).d₁) (Q.height u)) :=
  (A.positiveActionSpan (kernel (R w).d₁) (Q.height u)).mkQ.comp
    (A.pathRelationsToCategoricalASFirstKernel Q R u w huw)

theorem pathRelationsToASFirstKernelTop_surjective (u w : Q.LiftVertex) (huw : u≠w) :
    Function.Surjective (A.pathRelationsToASFirstKernelTop Q R u w huw) :=
  (A.positiveActionSpan (kernel (R w).d₁) (Q.height u)).mkQ_surjective.comp
    (A.pathRelationsToCategoricalASFirstKernel_surjective Q R u w huw)

theorem pathRelationsToASFirstKernelTop_ker (u w : Q.LiftVertex) (huw : u≠w) :
    LinearMap.ker (A.pathRelationsToASFirstKernelTop Q R u w huw)=
      Submodule.comap (A.pathRelationsToCategoricalASFirstKernel Q R u w huw)
        (A.positiveActionSpan (kernel (R w).d₁) (Q.height u)) := by
  ext f
  change (Submodule.Quotient.mk (A.pathRelationsToCategoricalASFirstKernel Q R u w huw f) :
    (A.rightModuleEvaluation (Q.height u)).obj (kernel (R w).d₁) ⧸
      A.positiveActionSpan (kernel (R w).d₁) (Q.height u))=0 ↔
        A.pathRelationsToCategoricalASFirstKernel Q R u w huw f∈
          A.positiveActionSpan (kernel (R w).d₁) (Q.height u)
  exact Submodule.Quotient.mk_eq_zero _

attribute [local irreducible] pathRelationsToASFirstKernelTop pathRelationHeightEquiv

set_option backward.isDefEq.respectTransparency false in
noncomputable def presentationMinimalRelationFirstKernelTopEquiv
    (u w : Q.LiftVertex) (huw : Q.height u < Q.height w) :
    Q.MinimalRelationComponent (A.unrolledPathPresentation Q R).kernel
      (Q.height u) (Q.height w) ≃ₗ[k]
      ((A.rightModuleEvaluation (Q.height u)).obj (kernel (R w).d₁) ⧸
        A.positiveActionSpan (kernel (R w).d₁) (Q.height u)) := by
  have hne : u≠w := by intro h; subst w; exact lt_irrefl _ huw
  let P : Submodule k (LinearMap.ker (A.unrolledPathLinearEvaluation Q R u w)) :=
    LinearMap.ker (A.pathRelationsToASFirstKernelTop Q R u w hne)
  let D : Submodule k ((A.unrolledPathPresentation Q R).kernel.hom
      (Q.height u) (Q.height w)) :=
    Submodule.comap ((A.unrolledPathPresentation Q R).kernel.hom
      (Q.height u) (Q.height w)).subtype
      (Q.relationDecomposables (A.unrolledPathPresentation Q R).kernel
        (Q.height u) (Q.height w))
  have hden : Submodule.map (A.pathRelationHeightEquiv Q R u w).toLinearMap P = D := by
    dsimp only [P, D]
    rw [A.pathRelationsToASFirstKernelTop_ker]
    exact A.pathRelationHeightEquiv_map_radical_preimage Q R u w huw
  let e₁ : (LinearMap.ker (A.unrolledPathLinearEvaluation Q R u w) ⧸ P) ≃ₗ[k]
      (((A.unrolledPathPresentation Q R).kernel.hom (Q.height u) (Q.height w)) ⧸ D) :=
    Submodule.Quotient.equiv
      (M := LinearMap.ker (A.unrolledPathLinearEvaluation Q R u w))
      (N := (A.unrolledPathPresentation Q R).kernel.hom (Q.height u) (Q.height w))
      P D (A.pathRelationHeightEquiv Q R u w) hden
  let e₂ : (LinearMap.ker (A.unrolledPathLinearEvaluation Q R u w) ⧸ P) ≃ₗ[k]
      ((A.rightModuleEvaluation (Q.height u)).obj (kernel (R w).d₁) ⧸
        A.positiveActionSpan (kernel (R w).d₁) (Q.height u)) :=
    LinearMap.quotKerEquivOfSurjective
      (M := LinearMap.ker (A.unrolledPathLinearEvaluation Q R u w))
      (M₂ := (A.rightModuleEvaluation (Q.height u)).obj (kernel (R w).d₁) ⧸
        A.positiveActionSpan (kernel (R w).d₁) (Q.height u))
      (A.pathRelationsToASFirstKernelTop Q R u w hne)
      (A.pathRelationsToASFirstKernelTop_surjective Q R u w hne)
  exact e₁.symm.trans e₂

end ASGinzburg.ZAlgebra
