import work.ASGinzburgDraft.PeriodCornerTotalModuleMorphisms

/-! Componentwise cover morphisms commute with all genuine native R actions. -/
namespace ASGinzburg.ZAlgebra.PeriodIso
open CategoryTheory Opposite
open scoped DirectSum
universe u v
variable {k : Type u} [Field k] {A : ZAlgebra.{u,v} k}
variable (Q : CutQuiver) (E : A.PeriodIso (Q.vertices:ℤ))

theorem cutHomogeneousRightOperator_naturality
    {M N : (E.cornerCoverZAlgebra Q).RightModule} (f : M⟶N)
    (m : ℕ) (r : E.CutGradedBlock (fun i : Q.Vertex => (i.val:ℤ)) m) :
    (E.cornerTotalModuleLinearMap Q f).comp (E.cutHomogeneousRightOperator Q M m r)=
      (E.cutHomogeneousRightOperator Q N m r).comp (E.cornerTotalModuleLinearMap Q f) := by
  apply DFinsupp.lhom_ext
  intro y v
  change E.cornerTotalModuleLinearMap Q f
    (E.cutHomogeneousRightOperator Q M m r
      (DirectSum.lof k Q.LiftVertex (E.CornerModuleSpace Q M) y v))=
    E.cutHomogeneousRightOperator Q N m r
      (E.cornerTotalModuleLinearMap Q f
        (DirectSum.lof k Q.LiftVertex (E.CornerModuleSpace Q M) y v))
  rw [E.cutHomogeneousRightOperator_lof,E.cornerTotalModuleLinearMap_lof,
    E.cutHomogeneousRightOperator_lof,E.cutRightColumnMap_apply,E.cutRightColumnMap_apply,map_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [E.cornerTotalModuleLinearMap_lof]
  congr 1
  exact LinearMap.congr_fun (E.cornerModuleMap_naturality Q f
    (E.cutCornerEntry Q m (cutRightSource Q m y i) y
      (cutRightSource_difference Q m y i) (r i y.1))) v

theorem cutRightRepresentation_naturality
    {M N : (E.cornerCoverZAlgebra Q).RightModule} (f : M⟶N)
    (r : E.CutGradedRing (fun i : Q.Vertex => (i.val:ℤ))) :
    (E.cornerTotalModuleLinearMap Q f).comp (E.cutRightRepresentation Q M r).unop=
      (E.cutRightRepresentation Q N r).unop.comp (E.cornerTotalModuleLinearMap Q f) := by
  refine DirectSum.induction_on r ?_ ?_ ?_
  · simp only [map_zero,MulOpposite.unop_zero,LinearMap.comp_zero,LinearMap.zero_comp]
  · intro m x
    change (E.cornerTotalModuleLinearMap Q f).comp
      (E.cutRightRepresentation Q M
        (E.cutHomogeneousInclusion (fun i : Q.Vertex => (i.val:ℤ)) m x)).unop=
      (E.cutRightRepresentation Q N
        (E.cutHomogeneousInclusion (fun i : Q.Vertex => (i.val:ℤ)) m x)).unop.comp _
    rw [E.cutRightRepresentation_homogeneous,E.cutRightRepresentation_homogeneous]
    exact E.cutHomogeneousRightOperator_naturality Q f m x
  · intro x y hx hy
    rw [map_add,map_add,MulOpposite.unop_add,MulOpposite.unop_add,
      LinearMap.comp_add,LinearMap.add_comp,hx,hy]

end ASGinzburg.ZAlgebra.PeriodIso
